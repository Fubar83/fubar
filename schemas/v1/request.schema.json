{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fubar83.github.io/fubar/schemas/v1/request.schema.json",
  "title": "Fubar API Studio request",
  "description": "One request.json under a workspace's collections/ tree.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "id": { "type": "string", "description": "Stable id. Keys this request's execution history." },
    "name": { "type": "string" },
    "kind": { "enum": ["http"], "default": "http" },
    "method": { "type": "string", "default": "GET" },
    "url": { "type": "string" },
    "queryParams": { "type": "array", "items": { "$ref": "#/$defs/keyValue" } },
    "headers": { "type": "array", "items": { "$ref": "#/$defs/keyValue" } },
    "body": { "$ref": "#/$defs/body" },
    "auth": { "$ref": "#/$defs/auth" },
    "authProfileId": { "type": ["string", "null"] },
    "timeoutSeconds": { "type": ["integer", "null"], "minimum": 1 },
    "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "suppressedInheritedHeaderKeys": { "type": "array", "items": { "type": "string" } },
    "comparison": { "$ref": "#/$defs/comparison" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "tolerances": { "type": ["array", "null"], "items": { "$ref": "#/$defs/tolerance" } },
    "settings": { "type": ["object", "null"], "description": "Protocol-owned data bag." },

    "localVariables": {
      "deprecated": true,
      "type": "array",
      "description": "Retired. Dropped by the one-time migration on open; variables resolve from the environment, the session store and the workspace manifest.",
      "items": { "$ref": "#/$defs/keyValue" }
    },
    "responseDiffIgnorePaths": {
      "deprecated": true,
      "type": "array",
      "description": "Superseded by comparison.ignoredPaths. Folded in by the one-time migration on open.",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "keyValue": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "enabled": { "type": "boolean", "default": true },
        "kind": {
          "enum": ["text", "file"],
          "default": "text",
          "description": "file is only meaningful in a formData body: the value is a path, sent as a file part."
        }
      }
    },
    "body": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "json", "formData", "urlEncoded", "rawText", "binaryFile"] },
        "raw": { "type": ["string", "null"] },
        "formData": { "type": "array", "items": { "$ref": "#/$defs/keyValue" } },
        "urlEncoded": { "type": "array", "items": { "$ref": "#/$defs/keyValue" } },
        "binaryFilePath": { "type": ["string", "null"] }
      }
    },
    "auth": {
      "type": "object",
      "description": "Credentials belong in {{variables}}, not here: this file is committed.",
      "properties": {
        "type": { "enum": ["inherit", "none", "bearer", "apiKey", "basic", "oauth2", "profile"] },
        "token": { "type": ["string", "null"] },
        "apiKeyName": { "type": ["string", "null"] },
        "apiKeyValue": { "type": ["string", "null"] },
        "apiKeyLocation": { "enum": ["header", "query"] },
        "username": { "type": ["string", "null"] },
        "password": { "type": ["string", "null"] },
        "accessTokenVariable": { "type": ["string", "null"] },
        "expiryVariable": { "type": ["string", "null"] },
        "expiresInExpression": { "type": ["string", "null"] },
        "tokenRequest": { "type": ["object", "null"] },
        "tokenCaptures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "authorizeUrl": {
          "type": ["string", "null"],
          "description": "Where the browser is sent for an authorization code. Only the authorization-code grant has one."
        },
        "authorizeParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyValue" },
          "description": "Extra query parameters for authorizeUrl - Google's access_type=offline, Auth0's audience."
        },
        "redirectPort": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535,
          "description": "Loopback port to catch the redirect on. Absent or 0 asks the OS for a free one, which most providers cannot have registered against them."
        },
        "signInProviderKey": {
          "type": ["string", "null"],
          "description": "Which built-in provider preset this was set up with. A label only; an unknown value is ignored."
        },
        "signInTenant": {
          "type": ["string", "null"],
          "description": "The tenant, directory or domain the provider's URLs were built for."
        }
      }
    },
    "capture": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "variableName": { "type": "string" },
        "source": { "enum": ["jsonBody", "header", "statusCode", "responseTimeMs"] },
        "expression": { "type": "string" },
        "scope": {
          "enum": ["session", "environment"],
          "description": "environment persists the value to environments/*.json, which is committed. Use session for anything credential-shaped."
        }
      }
    },
    "assertion": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "source": { "enum": ["jsonBody", "header", "statusCode", "responseTimeMs"] },
        "target": { "type": "string" },
        "operator": { "enum": ["equals", "notEquals", "contains", "lessThan", "greaterThan", "exists", "notExists"] },
        "expected": { "type": "string" }
      }
    },
    "comparison": {
      "type": ["object", "null"],
      "description": "Every member is nullable: null means inherit from the folder or the global default.",
      "properties": {
        "ignoreWhitespace": { "type": ["boolean", "null"] },
        "ignoreCase": { "type": ["boolean", "null"] },
        "normalizeStructure": { "type": ["boolean", "null"] },
        "reportPropertyOrder": { "type": ["boolean", "null"] },
        "matchArraysByPosition": { "type": ["boolean", "null"] },
        "ignoreNullVsMissing": { "type": ["boolean", "null"] },
        "ignoredPaths": { "$ref": "#/$defs/inheritedPaths" },
        "arrayKeyOverrides": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
        "unorderedArrays": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Arrays whose order does not matter, by JSON path - elements are matched by their whole value. Replaces rather than merges what it inherits, like arrayKeyOverrides: these three say how ONE array is matched, and an array can only be matched one way." },
        "positionalArrays": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Arrays compared element 0 against element 0, by JSON path - for a list whose order IS its content." }
      }
    },
    "inheritedPaths": {
      "description": "What this level ADDS and REMOVES, rather than the whole list. A bare array is read as add, which is how the pre-inheritance shape still loads.",
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" }, "deprecated": true },
        {
          "type": "object",
          "properties": {
            "add": { "type": "array", "items": { "type": "string" } },
            "remove": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "snapshotRule": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "$.a.b, $..token, $.items[*].id" },
        "as": { "type": "string", "description": "The replacement written into the file, e.g. <redacted>." }
      }
    },
    "inheritedRules": {
      "type": ["object", "null"],
      "properties": {
        "add": { "type": "array", "items": { "$ref": "#/$defs/snapshotRule" } },
        "remove": { "type": "array", "items": { "type": "string" }, "description": "By path: a level saying 'not here' need not repeat what the ancestor replaced it with." }
      }
    },
    "snapshot": {
      "type": ["object", "null"],
      "description": "What happens to a response on its way into a snapshot. Redact and normalise both run before the file is written; ignoring happens on read and leaves the real value committed.",
      "properties": {
        "redact": { "$ref": "#/$defs/inheritedRules" },
        "normalize": { "$ref": "#/$defs/inheritedRules" },
        "headers": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Response headers worth keeping. Absent keeps none; this list is closest-wins rather than add/remove."
        }
      }
    },
    "tolerance": {
      "type": "object",
      "required": ["path"],
      "description": "A field allowed to move, and by how much. Exactly one allowance per entry - none, or several, is reported and not applied.",
      "properties": {
        "path": { "type": "string" },
        "numeric": { "type": ["number", "null"] },
        "withinSeconds": { "type": ["number", "null"] },
        "matches": { "type": ["string", "null"] },
        "lengthWithinPercent": { "type": ["number", "null"] },
        "oneOf": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    }
  }
}
