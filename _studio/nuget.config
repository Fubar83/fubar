<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Folder feed for testing a Fubar.Controls build before it is published. Populate it with
         `./build/pack.ps1 -PushTo ../fubar-api-studio` from the fubar-components repo. It is kept in
         source control (via local-packages/.gitkeep) because NuGet errors on a source that does not
         exist - an empty folder is a valid, inert source, including on CI. -->
    <add key="fubar-local" value="local-packages" />
  </packageSources>
</configuration>
