<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fubar.Studio.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="160"
             x:Class="Fubar.Studio.UI.Views.StatusLogView"
             x:DataType="vm:StatusLogViewModel">

    <!-- Phase 5 adds real-time network telemetry rows here alongside debug log entries. -->
    <ListBox ItemsSource="{Binding Entries}"
             Margin="4"
             Background="Transparent"
             FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
             FontSize="12" />

</UserControl>
