<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Authors>Fubar Contributors</Authors>
    <Product>Fubar Diff</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- The shared component library (https://github.com/Fubar83/fubar-components) is consumed as a
       NuGet package by default. Set UseLocalComponents=true to build against its sources instead,
       which is what you want when changing a control and this app together - you get step-into
       debugging and no pack/restore round-trip:

         dotnet build -p:UseLocalComponents=true

       It assumes the two repositories are siblings; override FubarComponentsPath if yours are not. -->
  <PropertyGroup>
    <UseLocalComponents Condition="'$(UseLocalComponents)' == ''">false</UseLocalComponents>
    <FubarComponentsPath Condition="'$(FubarComponentsPath)' == ''">$(MSBuildThisFileDirectory)../fubar-components</FubarComponentsPath>
    <!-- A solution build unsets Configuration/Platform for ProjectReferences it does not own, so the
         out-of-solution library would build Debug even under `-c Release`. Keep the parent's values. -->
    <ShouldUnsetParentConfigurationAndPlatform Condition="'$(UseLocalComponents)' == 'true'">false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

</Project>
