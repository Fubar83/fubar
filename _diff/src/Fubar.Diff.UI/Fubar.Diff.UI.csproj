<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Output exe is FubarDiff.exe; the readable product/GUI title is "Fubar Diff"
         (see MainWindow.axaml). Project/assembly namespaces are Fubar.Diff.UI. -->
    <AssemblyName>FubarDiff</AssemblyName>
    <RootNamespace>Fubar.Diff.UI</RootNamespace>
    <Product>Fubar Diff</Product>
    <ApplicationTitle>Fubar Diff</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fubar.Diff.Infrastructure\Fubar.Diff.Infrastructure.csproj" />
    <ProjectReference Include="..\Fubar.Diff.Application\Fubar.Diff.Application.csproj" />
    <ProjectReference Include="..\Fubar.Diff.Core\Fubar.Diff.Core.csproj" />
  </ItemGroup>

  <!-- Shared component library: a package by default, or a ProjectReference into ../fubar-components
       when built with -p:UseLocalComponents=true. See Directory.Build.props. -->
  <ItemGroup Condition="'$(UseLocalComponents)' != 'true'">
    <PackageReference Include="Fubar.Controls" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalComponents)' == 'true'">
    <!-- SetConfiguration is required, not cosmetic: fubar-components is outside this solution, so a
         solution build does NOT propagate Configuration to it and it would quietly build Debug even
         for `dotnet build -c Release`. -->
    <ProjectReference Include="$(FubarComponentsPath)/src/Fubar.Controls/Fubar.Controls.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>
</Project>
