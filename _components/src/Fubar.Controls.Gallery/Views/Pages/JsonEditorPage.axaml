<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="using:Fubar.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="600"
             x:Class="Fubar.Controls.Gallery.Views.Pages.JsonEditorPage">

    <fc:Card>
        <fc:Card.Header>
            <fc:SectionHeader Title="JSON EDITOR" />
        </fc:Card.Header>
        <fc:JsonEditor x:Name="Editor" Height="420" />
    </fc:Card>

</UserControl>
