<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="using:Fubar.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="700"
             x:Class="Fubar.Controls.Gallery.Views.Pages.FeedbackPage">

    <StackPanel Spacing="18">

        <!-- Banner -->
        <fc:Card>
            <fc:Card.Header>
                <fc:SectionHeader Title="BANNER" />
            </fc:Card.Header>
            <StackPanel Spacing="8">
                <fc:Banner Severity="Info" Icon="&#x2139;" Message="Heads up - this is an informational banner." />
                <fc:Banner Severity="Success" Icon="&#x2713;" Message="Request saved successfully." />
                <fc:Banner Severity="Warning" Icon="&#x26A0;" Message="You switched away with unsaved changes." />
                <fc:Banner Severity="Error" Icon="&#x2717;" Message="Invalid JSONPath: unexpected token at position 4.">
                    <fc:Banner.Action>
                        <Button Classes="secondary-btn" Content="Dismiss" />
                    </fc:Banner.Action>
                </fc:Banner>
            </StackPanel>
        </fc:Card>

        <!-- Spinner -->
        <fc:Card>
            <fc:Card.Header>
                <fc:SectionHeader Title="SPINNER" />
            </fc:Card.Header>
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <fc:Spinner Diameter="16" />
                <fc:Spinner Diameter="24" />
                <fc:Spinner Diameter="36" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <fc:Spinner Diameter="16" />
                    <TextBlock Text="Sending..." Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </fc:Card>

        <!-- MetricChip -->
        <fc:Card>
            <fc:Card.Header>
                <fc:SectionHeader Title="METRIC CHIP" />
            </fc:Card.Header>
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <fc:MetricChip Icon="&#x23F1;" Text="128 ms" Foreground="{DynamicResource MethodGetBrush}" />
                <fc:MetricChip Icon="&#x23F1;" Text="1420 ms" Foreground="{DynamicResource MethodPutBrush}" />
                <fc:MetricChip Icon="&#x1F4E6;" Text="4.2 KB" />
            </StackPanel>
        </fc:Card>

        <!-- SegmentedControl -->
        <fc:Card>
            <fc:Card.Header>
                <fc:SectionHeader Title="SEGMENTED CONTROL" />
            </fc:Card.Header>
            <fc:SegmentedControl x:Name="Segments" HorizontalAlignment="Left" />
        </fc:Card>

    </StackPanel>

</UserControl>
