<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fubar.Controls.Gallery.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Palette in Resources so ThemeDictionaries follow RequestedThemeVariant. -->
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEdit theme so the JsonEditor component renders/focuses. -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- 2. The whole Fubar.Controls design system in one line (incl. the Inter Window font). -->
        <StyleInclude Source="avares://Fubar.Controls/Themes/Fubar.Controls.axaml" />
    </Application.Styles>
</Application>
