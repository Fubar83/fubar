# Normalize line endings: let Git decide in the working tree, store LF in the repo.
* text=auto

# Scripts that must stay LF regardless of platform
*.sh   text eol=lf

# Windows-oriented files stay CRLF
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets — never touch
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.gif  binary
