<Project>

  <!-- Shared compiler + analyzer settings for every project in this repository. Package metadata
       for the shipped library lives here too, so the .csproj only carries what is unique to it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Package identity. Only Fubar.Controls sets IsPackable=true (the Gallery and tests opt out),
       but these values are harmless everywhere and keep the .csproj files small. -->
  <PropertyGroup>
    <Authors>fubar83 and the Fubar.Controls contributors</Authors>
    <Company>Fubar</Company>
    <Product>Fubar.Controls</Product>
    <Copyright>Copyright (c) 2026 fubar83 and the Fubar.Controls contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Fubar83/fubar-components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Fubar83/fubar-components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <!-- Source Link: ships a symbol package and embeds the commit + untracked sources so consumers can
       step into library code from their own debugger. ContinuousIntegrationBuild normalises the
       embedded paths, which is what makes the build reproducible - only set it on CI. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Versions come from git tags (v1.2.3 -> 1.2.3); an untagged build gets a 0.0.0-alpha.N
       prerelease. Never hand-edit a version number. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
