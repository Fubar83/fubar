<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="using:Fubar.Controls">

    <!-- Explorer-tree look for fc:TreeView (see TreeView.cs). Taller rows + padding for a bigger click
         target; full-width hover/selected fills via palette tokens (so theme switches repaint instantly);
         the chevron's HIT AREA is enlarged (padding) without growing the glyph. Everything is scoped under
         "fc|TreeView ..." so ordinary TreeViews elsewhere keep the framework default. The descendant
         combinator (space) reaches TreeViewItems at every nesting level. Colours are Palette.axaml tokens. -->

    <Style Selector="fc|TreeView TreeViewItem">
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="fc|TreeView TreeViewItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <Style Selector="fc|TreeView TreeViewItem:selected">
        <Setter Property="Background" Value="{DynamicResource BgSelected}" />
    </Style>

    <Style Selector="fc|TreeView TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="Padding" Value="8" />
    </Style>

</Styles>
