<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Border-tint classes for a TextBox that contains {{variables}}: amber when something is
         undefined, blue when all resolve. An app's variable-highlight behavior sets one of these
         classes; the styling lives here (shared) so the look is identical across apps. Colours are
         palette tokens (Palette.axaml). -->

    <Style Selector="TextBox.variable-undefined">
        <Setter Property="BorderBrush" Value="{DynamicResource VariableUndefinedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.variable-valid">
        <Setter Property="BorderBrush" Value="{DynamicResource VariableValidBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</Styles>
