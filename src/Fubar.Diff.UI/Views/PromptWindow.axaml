<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fubar.Diff.UI.Views.PromptWindow"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgEditorCanvas}"
        Title="Enter a value">

    <!-- One line of text and two buttons. The input is monospaced because everything asked for here is
         a path or a field name, where a lowercase l next to a 1 matters. -->
    <StackPanel Margin="20" Spacing="14">

        <TextBlock x:Name="TitleText"
                   FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="MessageText"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" />

        <TextBox x:Name="Input"
                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="toolbar-btn" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Classes="primary-btn" Content="OK" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
