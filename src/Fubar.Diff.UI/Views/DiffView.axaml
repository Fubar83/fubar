<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fubar.Diff.UI.ViewModels"
             x:Class="Fubar.Diff.UI.Views.DiffView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Row tinting. These are the only app-local styles in the whole app, and they earn their
             place: "an added line is green" is a diff-domain rule, not a design-system one. The
             COLOURS still come from Fubar.Controls tokens so the two apps stay visually consistent. -->
        <Style Selector="Border.filler">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.inserted">
            <Setter Property="Background" Value="{DynamicResource MethodPostBrush}" />
            <Setter Property="Opacity" Value="0.18" />
        </Style>
        <Style Selector="Border.deleted">
            <Setter Property="Background" Value="{DynamicResource MethodDeleteBrush}" />
            <Setter Property="Opacity" Value="0.18" />
        </Style>
        <Style Selector="Border.modified">
            <Setter Property="Background" Value="{DynamicResource MethodPutBrush}" />
            <Setter Property="Opacity" Value="0.18" />
        </Style>

        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="Consolas, Menlo, 'DejaVu Sans Mono', monospace" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="TextBlock.gutter">
            <Setter Property="FontFamily" Value="Consolas, Menlo, 'DejaVu Sans Mono', monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,1,6,1" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
    </UserControl.Styles>

    <!-- One virtualising list of full-width rows, rather than two independently scrolling panes.
         That is deliberate: with a single scroller the two sides CANNOT drift out of alignment, which
         is the bug every side-by-side diff viewer eventually has. Horizontal scrolling is shared for
         the same reason. -->
    <ListBox x:Name="RowList"
             ItemsSource="{Binding Rows}"
             Background="Transparent"
             BorderThickness="0"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.Styles>
            <!-- Rows are data, not targets: strip the ListBoxItem chrome so selection highlight and
                 padding don't fight the change tinting. -->
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DiffRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,*">
                    <TextBlock Grid.Column="0" Classes="gutter" Text="{Binding LeftNumber}" />

                    <Border Grid.Column="1"
                            Classes.deleted="{Binding LeftDeleted}"
                            Classes.modified="{Binding IsModified}"
                            Classes.filler="{Binding LeftFiller}">
                        <TextBlock Classes="code" Text="{Binding LeftText}" />
                    </Border>

                    <Border Grid.Column="2" Width="1" Background="{DynamicResource BorderSubtle}" />

                    <TextBlock Grid.Column="3" Classes="gutter" Text="{Binding RightNumber}" />

                    <Border Grid.Column="4"
                            Classes.inserted="{Binding RightInserted}"
                            Classes.modified="{Binding IsModified}"
                            Classes.filler="{Binding RightFiller}">
                        <TextBlock Classes="code" Text="{Binding RightText}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
