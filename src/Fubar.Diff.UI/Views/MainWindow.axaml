<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fc="using:Fubar.Controls"
        xmlns:vm="using:Fubar.Diff.UI.ViewModels"
        xmlns:dv="using:Fubar.Diff.Controls.Views"
        xmlns:settings="using:Fubar.Diff.Core.Settings"
        xmlns:dvm="using:Fubar.Diff.Controls.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Fubar.Diff.UI.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Fubar Diff"
        Width="1200" Height="800"
        Background="{DynamicResource BgEditorCanvas}"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <!-- F7/F8 for change navigation matches every other diff tool; Ctrl+S saves the merge.
             These act on the SELECTED tab, so they route through it rather than the shell. -->
        <KeyBinding Gesture="F8" Command="{Binding SelectedTab.Pane.NextChangeCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding SelectedTab.Pane.PreviousChangeCommand}" />
        <!-- Alt+Up/Down do the same as F7/F8. The function keys match other diff tools, but they are
             a hand's move away from the text; Alt+arrows can be held down to walk a file. -->
        <KeyBinding Gesture="Alt+Down" Command="{Binding SelectedTab.Pane.NextChangeCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding SelectedTab.Pane.PreviousChangeCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SelectedTab.SaveCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding SelectedTab.TakeLeftCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding SelectedTab.TakeRightCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- The tab strip. Hidden while only one comparison is open: a single tab is chrome the user
             gains nothing from. Ctrl+T opens another. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="6,4,6,0"
                IsVisible="{Binding HasMultipleTabs}">
            <fc:TabStrip ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         CloseCommand="{Binding CloseTabCommand}"
                         ShowCloseButton="True">
                <fc:TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComparisonViewModel">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </DataTemplate>
                </fc:TabStrip.ItemTemplate>
            </fc:TabStrip>
        </Border>

        <!-- Everything below belongs to the SELECTED comparison. Scoping the DataContext here means
             the whole body binds to the tab exactly as it did when there was only one, rather than
             every binding growing a SelectedTab. prefix. -->
        <ContentControl DataContext="{Binding SelectedTab}"
                        x:DataType="vm:ComparisonViewModel">
        <DockPanel>
        <!-- Toolbar: the two file slots, comparison options, navigation, and merge. All styling comes
             from Fubar.Controls; this view declares none of its own. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">

                <!-- The file row, expanded. Everything about WHICH files are being compared lives here
                     (including Recent and + Tab, which are the same question asked differently);
                     everything about how to view or merge them lives in the toolbar below. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                      ColumnDefinitions="*,Auto,*,Auto"
                      IsVisible="{Binding IsFileRowExpanded}">
                    <fc:LabeledField Grid.Column="0" Header="Left" Margin="0,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="Choose a file…" />
                            <Button Grid.Column="1" Classes="secondary-btn" Content="Browse…"
                                    Margin="6,0,0,0" Command="{Binding BrowseLeftCommand}" />
                        </Grid>
                    </fc:LabeledField>

                    <fc:Divider Grid.Column="1" Orientation="Vertical" Margin="4,0" />

                    <fc:LabeledField Grid.Column="2" Header="Right" Margin="8,0,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding RightPath}" PlaceholderText="Choose a file…" />
                            <Button Grid.Column="1" Classes="secondary-btn" Content="Browse…"
                                    Margin="6,0,0,0" Command="{Binding BrowseRightCommand}" />
                        </Grid>
                    </fc:LabeledField>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Classes="primary-btn" Content="Compare"
                                Command="{Binding CompareCommand}" IsEnabled="{Binding !IsBusy}" />

                        <!-- Recent and New tab belong to the SHELL, not this tab, so they reach back up
                             to the window's DataContext. Recent is hidden rather than disabled when
                             empty: an always-greyed control on first run is just clutter. -->
                        <Button Classes="toolbar-btn" Content="Recent ▾"
                                IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Recent.Count}">
                            <Button.Flyout>
                                <MenuFlyout ItemsSource="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Recent}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="settings:RecentComparison">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="Command"
                                                    Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenRecentCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="toolbar-btn" Content="+ Tab" ToolTip.Tip="Open another comparison (Ctrl+T)"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NewTabCommand}" />

                        <!-- A merge needs three files and resolves per region rather than per hunk, so
                             it opens its own window rather than becoming a second mode of this one.
                             The button sits with the file pickers because it answers the same question
                             they do: what am I looking at. -->
                        <Button Classes="toolbar-btn" Content="3-way merge…"
                                ToolTip.Tip="Merge two edits of a common ancestor"
                                Click="OnMergeClick" />

                        <Button Classes="toolbar-btn" Content="Folders…"
                                ToolTip.Tip="Compare two directory trees, and open the files that differ"
                                Click="OnFoldersClick" />
                    </StackPanel>
                </Grid>

                <!-- …and collapsed, which is what it becomes the moment a comparison succeeds. One
                     line naming both files, clickable to get the pickers back. -->
                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Classes="toolbar-btn"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding !IsFileRowExpanded}"
                        ToolTip.Tip="Change the files being compared"
                        Command="{Binding ToggleFileRowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <TextBlock Text="▾" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- One row, not two. It fits now because the things that were padding it out have
                     moved to where they belong: Recent/+ Tab to the file row above, the theme picker
                     into Settings, and the merge buttons behind the state that makes them usable. -->
                <fc:Toolbar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">

                    <!-- Icon-only: F7/F8, the diff map and the "Difference 1 of 3" status line all say
                         the same thing already, so the words were the third copy.
                         Hidden in Json mode, where JsonView carries its own Prev/Next: these walk
                         HUNKS (a text-alignment idea) and those walk semantic CHANGES, so showing both
                         at once offers two next buttons that disagree about what "next" means. -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding !Pane.IsJsonViewVisible}">
                        <Button Classes="toolbar-btn" Content="◀" ToolTip.Tip="Previous change (F7 or Alt+Up)"
                                Command="{Binding Pane.PreviousChangeCommand}" IsEnabled="{Binding Pane.HasChanges}" />
                        <Button Classes="toolbar-btn" Content="▶" ToolTip.Tip="Next change (F8 or Alt+Down)"
                                Command="{Binding Pane.NextChangeCommand}" IsEnabled="{Binding Pane.HasChanges}" />
                    </StackPanel>

                    <!-- Merge acts on the CURRENT change, so the whole group APPEARS with one rather
                         than sitting greyed out for the entire time nobody is merging - which, for
                         someone only reading a diff, is the whole session. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                                IsVisible="{Binding Pane.HasCurrentHunk}">
                        <fc:Divider Orientation="Vertical" Margin="0,0,2,0" />
                        <Button Classes="toolbar-btn" Content="← Take left" ToolTip.Tip="Use the left version of this change (Alt+Left)"
                                Command="{Binding TakeLeftCommand}" />
                        <Button Classes="toolbar-btn" Content="Take right →" ToolTip.Tip="Use the right version of this change (Alt+Right)"
                                Command="{Binding TakeRightCommand}" />
                        <Button Classes="toolbar-btn" Content="Reset" ToolTip.Tip="Undo the decision on this change"
                                Command="{Binding ResetHunkCommand}" />
                    </StackPanel>

                    <!-- Likewise: nothing to save until a decision has been made, so nothing is shown. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                                IsVisible="{Binding HasUnsavedMerge}">
                        <fc:Divider Orientation="Vertical" Margin="0,0,2,0" />
                        <Button Classes="primary-btn" Content="Save" ToolTip.Tip="Write the merged result (Ctrl+S)"
                                Command="{Binding SaveCommand}" />
                        <Button Classes="toolbar-btn" Content="Save as…" ToolTip.Tip="Write the merged result to a new file"
                                Command="{Binding SaveAsCommand}" />
                    </StackPanel>

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- Labelled inline rather than left to the tooltip alone: "Text"/"Json" show up
                         again below as the VIEW toggle, and the two are easy to conflate at a glance
                         without something distinguishing "how to compare" from "what to show". -->
                    <TextBlock Text="Compare:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{x:Static vm:ComparisonViewModel.ModeOptions}"
                              SelectedItem="{Binding Mode}"
                              MinWidth="76"
                              ToolTip.Tip="Auto compares JSON semantically and everything else as text; Text/Json force one or the other" />

                    <!-- The one comparison option worth a click of its own: reviewing code, this is the
                         toggle developers reach for constantly, unlike the rest below (set once per
                         session, if ever). -->
                    <CheckBox Content="Ignore whitespace" IsChecked="{Binding IgnoreWhitespace}" Margin="8,0,0,0" />

                    <!-- Everything else opens the detailed settings window instead of fighting for
                         space in this row - a modal rather than a flyout now that it also covers
                         array key overrides and ignore rules, which need more room than a popover
                         comfortably gives them (see SettingsWindow). -->
                    <Button Classes="toolbar-btn" Content="Settings…" Margin="8,0,0,0"
                            ToolTip.Tip="More comparison options, and the theme" Click="OnSettingsClick" />

                    <!-- Hidden until there is something to export, like every other conditional
                         control here. A patch of no changes is not worth a file. -->
                    <Button Classes="toolbar-btn" Content="Patch ▾" Margin="8,0,0,0"
                            IsVisible="{Binding HasPatch}"
                            ToolTip.Tip="Export this comparison as a unified diff, which git apply and patch understand">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Copy to clipboard" Command="{Binding CopyPatchCommand}" />
                                <MenuItem Header="Save as…" Command="{Binding ExportPatchCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- One "how it's displayed" group: the Diff pane toggle and the View switch are
                         both about that, not two separate ideas needing a divider between them. -->
                    <CheckBox Content="Diff pane"
                              ToolTip.Tip="Show the current difference close up, below the panes"
                              IsChecked="{Binding Pane.IsDetailVisible}"
                              VerticalAlignment="Center" />

                    <!-- Earns its place in the row rather than in Settings: on a file of any size this
                         is the difference between two screens and two hundred, so it is reached for
                         per-comparison rather than set once. -->
                    <CheckBox Content="Collapse unchanged"
                              ToolTip.Tip="Hide long stretches of identical context, keeping a few lines either side of each change. Click any fold to expand it."
                              IsChecked="{Binding CollapseUnchanged}"
                              VerticalAlignment="Center" />

                    <!-- Side by side / Unified / Json. Always offered now: the first two apply to any
                         comparison, where Json alone did not, so this no longer hides itself for a
                         plain text file - Pane.Show still picks the right default for the content.
                         Labelled for the same reason the Compare mode above is: both selectors offer
                         similar-looking words for different questions ("how to compare" vs "what to
                         show right now"). -->
                    <TextBlock Text="View:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Margin="12,0,4,0" />
                    <fc:SegmentedControl ItemsSource="{Binding Pane.AvailableViewModes}"
                                         SelectedItem="{Binding Pane.ViewMode}" />

                </fc:Toolbar>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" />
                <fc:Badge Grid.Column="1" Content="Unsaved merge"
                          IsVisible="{Binding HasUnsavedMerge}" />
            </Grid>
        </Border>

        <fc:Banner DockPanel.Dock="Top"
                   Severity="Error"
                   Message="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Raised only when a refresh was DECLINED - which happens for one reason, unsaved merge
             decisions, since a new comparison renumbers the hunks those are keyed by. Everything else
             reloads silently. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHover}"
                Padding="10,6"
                IsVisible="{Binding FilesChangedOnDisk}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="The files changed on disk. Reloading will discard your unsaved merge decisions."
                           Foreground="{DynamicResource PostmanAmberBrush}"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="toolbar-btn" Content="Reload" Command="{Binding ReloadCommand}" />
            </StackPanel>
        </Border>

        <!-- Encodings, BOMs and line endings never reach the panes - the reader consumes them - so a
             file pair that differs only in those shows two identical-looking documents and no rows.
             This is the only place that difference can be reported at all. -->
        <fc:Banner DockPanel.Dock="Top"
                   Severity="Warning"
                   Message="{Binding FormatDifferenceDetail, StringFormat='These files differ in format: {0}'}"
                   IsVisible="{Binding HasFormatDifference}" />

        <Panel>
            <fc:EmptyState Title="Nothing to compare yet"
                           Description="Pick a file on each side to see a side-by-side diff."
                           IsVisible="{Binding Pane.LeftDocument, Converter={x:Static ObjectConverters.IsNull}}" />

            <!-- Both bind to the pane, not to the tab: they are the embeddable widget, shared with
                 API Studio, and know nothing about files, options or merge. -->
            <dv:DiffView x:Name="Diff"
                         DataContext="{Binding Pane}"
                         IsVisible="{Binding IsSideBySideViewVisible}" />

            <dv:UnifiedView x:Name="Unified"
                            DataContext="{Binding Pane}"
                            IsVisible="{Binding IsUnifiedViewVisible}" />

            <dv:JsonView DataContext="{Binding Pane}"
                         IsVisible="{Binding IsJsonViewVisible}" />
        </Panel>
        </DockPanel>
        </ContentControl>
    </DockPanel>
</Window>
