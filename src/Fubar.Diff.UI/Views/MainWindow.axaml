<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fc="using:Fubar.Controls"
        xmlns:vm="using:Fubar.Diff.UI.ViewModels"
        xmlns:views="using:Fubar.Diff.UI.Views"
        xmlns:settings="using:Fubar.Diff.Core.Settings"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Fubar.Diff.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Fubar Diff"
        Width="1200" Height="800"
        Background="{DynamicResource BgEditorCanvas}"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <!-- F7/F8 for change navigation matches every other diff tool; Ctrl+S saves the merge. -->
        <KeyBinding Gesture="F8" Command="{Binding NextChangeCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding PreviousChangeCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding TakeLeftCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding TakeRightCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Toolbar: the two file slots, comparison options, navigation, and merge. All styling comes
             from Fubar.Controls; this view declares none of its own. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto">

                <fc:LabeledField Grid.Row="0" Grid.Column="0" Header="Left" Margin="0,0,8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding LeftPath}" PlaceholderText="Choose a file…" />
                        <Button Grid.Column="1" Classes="secondary-btn" Content="Browse…"
                                Margin="6,0,0,0" Command="{Binding BrowseLeftCommand}" />
                    </Grid>
                </fc:LabeledField>

                <fc:Divider Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="4,0" />

                <fc:LabeledField Grid.Row="0" Grid.Column="2" Header="Right" Margin="8,0,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding RightPath}" PlaceholderText="Choose a file…" />
                        <Button Grid.Column="1" Classes="secondary-btn" Content="Browse…"
                                Margin="6,0,0,0" Command="{Binding BrowseRightCommand}" />
                    </Grid>
                </fc:LabeledField>

                <fc:Toolbar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Button Classes="primary-btn" Content="Compare"
                            Command="{Binding CompareCommand}" IsEnabled="{Binding !IsBusy}" />

                    <!-- Recent pairs. Hidden rather than disabled when empty: an always-greyed control
                         on first run is just clutter. -->
                    <Button Classes="toolbar-btn" Content="Recent ▾"
                            Margin="6,0,0,0"
                            IsVisible="{Binding !!Recent.Count}">
                        <Button.Flyout>
                            <MenuFlyout ItemsSource="{Binding Recent}">
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="settings:RecentComparison">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="Command"
                                                Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ModeOptions}"
                              SelectedItem="{Binding Mode}"
                              MinWidth="76"
                              ToolTip.Tip="Auto compares JSON semantically and everything else as text" />

                    <CheckBox Content="Ignore whitespace" IsChecked="{Binding IgnoreWhitespace}" Margin="8,0,0,0" />
                    <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" Margin="12,0,0,0" />

                    <!-- JSON-only options: shown only once a semantic comparison has actually run, so
                         they are not offered where they would do nothing. -->
                    <CheckBox Content="Report key order"
                              IsChecked="{Binding ReportPropertyOrder}"
                              IsVisible="{Binding IsSemantic}"
                              Margin="12,0,0,0"
                              ToolTip.Tip="JSON objects are unordered, so reordering is not a difference by default" />
                    <CheckBox Content="Arrays by position"
                              IsChecked="{Binding MatchArraysByPosition}"
                              IsVisible="{Binding IsSemantic}"
                              Margin="12,0,0,0"
                              ToolTip.Tip="Match array elements by index instead of by an identity key" />
                    <CheckBox Content="Normalize XML"
                              IsChecked="{Binding NormalizeStructure}"
                              IsVisible="{Binding !IsSemantic}"
                              Margin="12,0,0,0" />

                </fc:Toolbar>

                <!-- Actions on their own row. One row cannot hold everything at a usable window
                     width - it clips the rightmost controls, and a toolbar that hides Save is worse
                     than one that takes an extra 30px. -->
                <fc:Toolbar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <Button Classes="toolbar-btn" Content="◀ Prev" ToolTip.Tip="Previous change (F7)"
                            Command="{Binding PreviousChangeCommand}" IsEnabled="{Binding HasChanges}" />
                    <Button Classes="toolbar-btn" Content="Next ▶" ToolTip.Tip="Next change (F8)"
                            Command="{Binding NextChangeCommand}" IsEnabled="{Binding HasChanges}" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- Merge acts on the CURRENT change, so these stay disabled until one is selected. -->
                    <Button Classes="toolbar-btn" Content="← Take left" ToolTip.Tip="Use the left version of this change (Alt+Left)"
                            Command="{Binding TakeLeftCommand}" IsEnabled="{Binding HasCurrentHunk}" />
                    <Button Classes="toolbar-btn" Content="Take right →" ToolTip.Tip="Use the right version of this change (Alt+Right)"
                            Command="{Binding TakeRightCommand}" IsEnabled="{Binding HasCurrentHunk}" />
                    <Button Classes="toolbar-btn" Content="Reset" ToolTip.Tip="Undo the decision on this change"
                            Command="{Binding ResetHunkCommand}" IsEnabled="{Binding HasCurrentHunk}" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <Button Classes="primary-btn" Content="Save" ToolTip.Tip="Write the merged result (Ctrl+S)"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding HasUnsavedMerge}" />
                    <Button Classes="toolbar-btn" Content="Save as…"
                            Command="{Binding SaveAsCommand}" IsEnabled="{Binding HasChanges}" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- Text / Tree. Only offered when a semantic comparison ran, since the tree has
                         nothing to show for a plain text file. -->
                    <fc:SegmentedControl ItemsSource="{x:Static vm:MainViewModel.ViewModeOptions}"
                                         SelectedItem="{Binding ViewMode}"
                                         IsVisible="{Binding IsSemantic}" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" IsVisible="{Binding IsSemantic}" />

                    <ComboBox ItemsSource="{x:Static vm:ThemeManagerViewModel.ThemeOptions}"
                              SelectedItem="{Binding ThemeManager.CurrentTheme}"
                              MinWidth="90" />
                </fc:Toolbar>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" />
                <fc:Badge Grid.Column="1" Content="Unsaved merge"
                          IsVisible="{Binding HasUnsavedMerge}" />
            </Grid>
        </Border>

        <fc:Banner DockPanel.Dock="Top"
                   Severity="Error"
                   Message="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Panel>
            <fc:EmptyState Title="Nothing to compare yet"
                           Description="Pick a file on each side to see a side-by-side diff."
                           IsVisible="{Binding LeftDocument, Converter={x:Static ObjectConverters.IsNull}}" />

            <views:DiffView x:Name="Diff"
                            IsVisible="{Binding IsTextViewVisible}" />

            <views:JsonTreeView IsVisible="{Binding IsTreeViewVisible}" />
        </Panel>
    </DockPanel>
</Window>
