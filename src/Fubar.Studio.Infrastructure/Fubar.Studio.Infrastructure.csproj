<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fubar.Studio.Core\Fubar.Studio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published schemas, embedded rather than copied. ONE copy: the validate command has to work
         on a build agent with no network, and a second copy under this project would be a second thing
         to keep in step with the first. Link keeps the repository's schemas/v1/ the only source. -->
    <EmbeddedResource Include="..\..\schemas\v1\*.schema.json" Link="schemas\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KeySharp" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="JsonPath.Net" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
