<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fubar.Studio.UI.App"
             xmlns:local="using:Fubar.Studio.UI">
             <!-- No hardcoded RequestedThemeVariant: ThemeManagerViewModel sets it at startup from
                  the user's persisted Dark/Light/System preference (see App.axaml.cs) and again at
                  runtime whenever the Left Pane's theme switcher changes it.

                  ALL styling lives in the Fubar.Controls shared library now - palette, accent, fonts,
                  component themes, button/tab/tree/list styles and the variable-tint classes. This app
                  declares no styles of its own; it only wires up ViewLocator + the framework themes
                  (Fluent / DataGrid / AvaloniaEdit) that Fubar.Controls builds on. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared palette (colours + pinned accent). In Application.Resources so its
                     ThemeDictionaries respond to ThemeManagerViewModel's RequestedThemeVariant switch. -->
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The app mark, per theme.

                 The OS icon cannot follow the theme - Windows and macOS each show one application
                 icon and never ask for a second - but the title bar is drawn by this app, and an
                 off-white plaque on a near-black title bar is the brightest thing in the window,
                 which is backwards for a decoration.

                 An ImageBrush rather than an Image Source: a DynamicResource has to resolve to an
                 object, and a brush is the one image-shaped thing that already is one.

                 Paths are relative, not avares:// - the authority in an avares URI is the ASSEMBLY
                 name, which here is FubarAPIStudio rather than the project name, and getting that
                 wrong fails at runtime on the first theme that needs it rather than at build. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <ImageBrush x:Key="AppMark" Stretch="Uniform"
                                Source="/Assets/fubar-256.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ImageBrush x:Key="AppMark" Stretch="Uniform"
                                Source="/Assets/fubar-256.png" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageBrush x:Key="AppMark" Stretch="Uniform"
                                Source="/Assets/fubar-256-dark.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- Without this, AvaloniaEdit's TextEditor has no control theme at all - it neither
             renders nor becomes focusable (Body Json/RawText editor + Response Pretty view). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- The entire shared design system: palette-driven component themes, SeamlessTabControl/TabStrip,
             KeyValueGrid, button/tab/tree/list class styles, fonts, and the variable-tint classes. -->
        <StyleInclude Source="avares://Fubar.Controls/Themes/Fubar.Controls.axaml" />
    </Application.Styles>
</Application>
