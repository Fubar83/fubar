<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fubar.Studio.UI.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:methodConv="using:Fubar.Studio.UI.Converters"
             xmlns:controls="using:Fubar.Studio.UI.Controls"
             xmlns:fc="using:Fubar.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="400"
             x:Class="Fubar.Studio.UI.Views.WorkspaceExplorerView"
             x:DataType="vm:WorkspaceExplorerViewModel"
             Background="{DynamicResource BgSidebar}">

    <!-- All tree-row styling comes from Fubar.Controls (AppStyles.axaml) now - this view declares
         none of its own, except the one below, which is behaviour rather than styling. -->
    <UserControl.Styles>
        <!-- The filter hides CONTAINERS rather than removing items from the bound collection. Removing
             them would mean maintaining a second, filtered tree alongside the real one - and the real
             one is what a run walks (see WorkspaceNodeViewModel.ToTreeNode), so the two drifting apart
             would silently change what a Run sends. Hiding keeps one tree with one meaning. -->
        <Style Selector="TreeViewItem" x:DataType="vm:WorkspaceNodeViewModel">
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />

            <!-- Folding lives on the NODE, not on the container. Containers are rebuilt whenever
                 SyncChildren reconciles against a file-system change, and a fold remembered by the
                 container would spring open every time someone saved a request. Two-way, so the +/-
                 box writes back to the node it came from. Open to begin with (see IsExpanded).

                 Through fc:TreeItemState rather than straight onto TreeViewItem.IsExpanded: the
                 expander writes a fold as a LOCAL value, which outranks a style setter permanently, so
                 binding IsExpanded here would work until the first fold by hand and be ignored after
                 that - filter matches included. -->
            <Setter Property="fc:TreeItemState.ExpandedPath" Value="IsExpanded" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Said, not left to be discovered: a scratch request is saved somewhere the user did not
             choose, which is the whole point of it and also the thing they need to know before
             relying on it. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsScratchActive}"
                Background="{DynamicResource BgHeader}"
                Padding="10,6"
                Margin="0,0,0,4">
            <TextBlock Text="Scratch. Anything saved here lives with the app, not in a folder you chose - move it into a workspace when it is worth keeping."
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
        </Border>

        <!-- Which half of the product this workspace is in, and what that costs. The conversion
             existed but lived in a right-click menu you had to already know about - which is how
             "the split closes by choice" turns into "closes never" (spec §10.4). Converting is still
             a choice: nothing is rewritten on open. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsRequestsFormatActive}"
                Background="{DynamicResource BgHeader}"
                Padding="10,7"
                Margin="0,0,0,4">
            <StackPanel Spacing="6">
                <TextBlock Text="Requests format. No cases, batches, snapshots or per-case rules here - those need endpoints."
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" />

                <Button Classes="secondary-btn"
                        Content="Convert to endpoints…"
                        FontSize="11"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Command="{Binding ConvertToEndpointsCommand}"
                        ToolTip.Tip="Splits every request into an endpoint and one case, after a preview. Copies the originals to .fubar/backup/ first." />
            </StackPanel>
        </Border>

        <!-- Only the active workspace tab's own children populate the tree - the root itself isn't
             represented here anymore, since its name is already shown by its title-bar tab. -->
        <!-- Horizontal scrolling off on purpose: it is what let rows overflow rather than ellipse, so
             a long name or one badge too many pushed the auth badge off the edge and grew a scrollbar
             nobody wants in a 260px pane. Off, the viewport width constrains every row. -->
        <fc:TreeView ItemsSource="{Binding ActiveRoot.Children}"
                  SelectedItem="{Binding SelectedNode}"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Tapped="TreeView_OnTapped"
                  PointerPressed="TreeView_OnPointerPressed">

            <fc:TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="Run" Command="{Binding RunCommand}" />
                    <MenuItem Header="Compare across environments…"
                              Command="{Binding CompareEnvironmentsCommand}"
                              ToolTip.Tip="Send every request to two environments and show where their answers differ" />
                    <Separator />
                    <!-- One of these, never both: two ways to make the same thing is how a tree ends
                         up half in one format and half in the other. -->
                    <MenuItem Header="New Request"
                              Command="{Binding NewRequestCommand}"
                              IsVisible="{Binding UsesRequests}" />
                    <MenuItem Header="New Endpoint"
                              Command="{Binding NewRequestCommand}"
                              IsVisible="{Binding UsesEndpoints}" />
                    <MenuItem Header="New Case"
                              Command="{Binding NewCaseCommand}"
                              IsVisible="{Binding CanAddCase}"
                              ToolTip.Tip="One way of calling this endpoint - its parameters, and what it should answer" />
                    <MenuItem Header="New Batch"
                              Command="{Binding NewBatchCommand}"
                              IsVisible="{Binding CanAddBatch}"
                              ToolTip.Tip="Which of this endpoint&apos;s cases to send, in what order, and what should judge them" />
                    <MenuItem Header="New Folder" Command="{Binding NewFolderCommand}" />
                    <Separator />
                    <!-- A plain left-click on a folder row does not select it in this tree, so the
                         folder's own settings need a way in that does not depend on that. -->
                    <MenuItem Header="Folder settings…"
                              Command="{Binding OpenFolderSettingsCommand}"
                              IsVisible="{Binding CanOpenFolderSettings}"
                              ToolTip.Tip="Headers, auth and rules inherited by everything beneath this folder" />
                    <Separator />
                    <MenuItem Header="Convert to endpoints…"
                              Command="{Binding ConvertToEndpointsCommand}"
                              IsVisible="{Binding UsesRequests}"
                              ToolTip.Tip="Split every request into an endpoint and one case. Copies the originals to .fubar/backup/ first." />
                    <Separator />
                    <!-- Hidden rather than greyed when there is nowhere to move to, which is this
                         codebase's rule for a control that cannot do anything right now. Its items
                         are the OTHER open workspaces - the ones whose format is known and whose tree
                         is already watching. -->
                    <MenuItem Header="Move to workspace"
                              ItemsSource="{Binding MoveTargets}"
                              IsVisible="{Binding CanMove}"
                              ToolTip.Tip="Takes it out of here and puts it in another open workspace">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="vm:WorkspaceRootViewModel">
                                <Setter Property="Header" Value="{Binding Workspace.Manifest.Name}" />
                                <Setter Property="Command"
                                        Value="{Binding $parent[TreeView].((vm:WorkspaceExplorerViewModel)DataContext).MoveToWorkspaceCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="Rename" Command="{Binding BeginRenameCommand}" />
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                    <Separator />
                    <MenuItem Header="Reveal in File Manager" Command="{Binding RevealInFileManagerCommand}" />
                </MenuFlyout>
            </fc:TreeView.ContextFlyout>

            <fc:TreeView.DataTemplates>
                <!-- One template for both folder and request nodes (LeftPane.md §5): the method
                     badge, auth badge, and dirty dot are simply invisible on a folder node, since
                     WorkspaceNodeViewModel.Method/HasAuthOverride/IsDirty are only ever populated
                     for request files. -->
                <TreeDataTemplate DataType="vm:WorkspaceNodeViewModel" ItemsSource="{Binding DisplayChildren}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="20">
                        <!-- Method Badge (fc:Badge - the reusable pill) -->
                        <fc:Badge Grid.Column="0"
                                  Width="38"
                                  Height="16"
                                  CornerRadius="3"
                                  Padding="0"
                                  Margin="0,0,6,0"
                                  FontSize="9"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Content="{Binding Method}"
                                  IsVisible="{Binding Method, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                  Background="{Binding Method, Converter={x:Static methodConv:MethodToBrushConverter.Instance}}" />

                        <!-- A case carries no method of its own - it is one way of calling the
                             endpoint above it - so the badge slot says what the row IS instead of
                             leaving a gap that reads as a missing badge. A batch uses the same slot
                             for the same reason: the two kinds of child an endpoint has are told
                             apart by this tag and nothing else. -->
                        <TextBlock Grid.Column="0"
                                   Width="38"
                                   Margin="0,0,6,0"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="case"
                                   ToolTip.Tip="One way of calling this endpoint"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding IsCase}" />

                        <TextBlock Grid.Column="0"
                                   Width="38"
                                   Margin="0,0,6,0"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Text="batch"
                                   ToolTip.Tip="A named list of calls to make together, belonging to this endpoint"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding IsBatch}" />

                        <!-- Name / inline rename -->
                        <Panel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       IsVisible="{Binding !IsEditing}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBox Text="{Binding EditName}"
                                     IsVisible="{Binding IsEditing}"
                                     fc:FocusHelper.FocusOnTrue="{Binding IsEditing}"
                                     KeyDown="EditNameTextBox_OnKeyDown"
                                     LostFocus="EditNameTextBox_OnLostFocus" />
                        </Panel>

                        <!-- Auth Override Badge (fc:Badge).

                             Two of them, because "this request states its own auth" and "this request
                             deliberately sends none" are opposite facts that both used to render as
                             one blue pill reading "Auth" - so the single request in a collection that
                             must go out unauthenticated looked exactly like the ones carrying a
                             token. BadgeAuthNone had been in the palette for this the whole time and
                             was referenced by nothing. -->
                        <fc:Badge Grid.Column="3"
                                  Content="Auth"
                                  FontSize="9"
                                  FontWeight="Normal"
                                  Foreground="White"
                                  Background="{DynamicResource BadgeAuth}"
                                  CornerRadius="3"
                                  Padding="4,1"
                                  Margin="4,0"
                                  ToolTip.Tip="This request sets its own auth instead of inheriting"
                                  IsVisible="{Binding !SendsNoAuth}"
                                  VerticalAlignment="Center">
                            <fc:Badge.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasAuthOverride" />
                                    <Binding Path="!SendsNoAuth" />
                                </MultiBinding>
                            </fc:Badge.IsVisible>
                        </fc:Badge>

                        <fc:Badge Grid.Column="3"
                                  Content="No auth"
                                  FontSize="9"
                                  FontWeight="Normal"
                                  Foreground="White"
                                  Background="{DynamicResource BadgeAuthNone}"
                                  CornerRadius="3"
                                  Padding="4,1"
                                  Margin="4,0"
                                  ToolTip.Tip="This request deliberately sends no auth, overriding what it would inherit"
                                  IsVisible="{Binding SendsNoAuth}"
                                  VerticalAlignment="Center" />

                        <!-- Case count and snapshot state, in ONE stack: separate cells in the same
                             grid column drew on top of each other. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                    VerticalAlignment="Center" Margin="4,0">

                            <!-- What is inside, while it is shut. One chip, not two: the pane is 260px
                                 and a second one pushed the auth badge off the edge. -->
                            <TextBlock Text="{Binding ContentsText}"
                                       IsVisible="{Binding HasContents}"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <!-- Snapshot state. Three meanings, one glyph.

                                 STALE is the one that earns its place: a green regression run against
                                 a snapshot recorded before the endpoint or case changed is a lie, and
                                 this is the only place anyone can notice it before running. -->
                            <TextBlock Text="●" IsVisible="{Binding HasSnapshot}"
                                       FontSize="10" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding SnapshotTooltip}"
                                       Foreground="{DynamicResource StatusSuccessFg}" />

                            <TextBlock Text="○" IsVisible="{Binding HasNoSnapshot}"
                                       FontSize="10" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding SnapshotTooltip}"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <TextBlock Text="⚑" IsVisible="{Binding HasStaleSnapshot}"
                                       FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding SnapshotTooltip}"
                                       Foreground="{DynamicResource StatusClientErrorFg}" />
                        </StackPanel>

                        <!-- Unsaved dot (fc:StatusDot): edited and not saved, or never saved at all.
                             A draft has no file behind it yet, and the dot is what says the row is
                             something you still owe a Save. -->
                        <fc:StatusDot Grid.Column="4"
                                      Diameter="6"
                                      Background="{DynamicResource StatusDirty}"
                                      IsVisible="{Binding IsUnsaved}"
                                      Margin="4,0,2,0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Unsaved" />
                    </Grid>
                </TreeDataTemplate>
            </fc:TreeView.DataTemplates>

        </fc:TreeView>

    </DockPanel>

</UserControl>
