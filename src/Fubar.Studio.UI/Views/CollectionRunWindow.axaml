<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fubar.Studio.UI.ViewModels"
        xmlns:fc="using:Fubar.Controls"
        xmlns:avc="using:Avalonia.Data.Converters"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
        x:Class="Fubar.Studio.UI.Views.CollectionRunWindow"
        x:DataType="vm:CollectionRunViewModel"
        Title="Run collection"
        Width="840" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSidebar}">

    <Window.Styles>
        <!-- Row status pill. One class per outcome, bound from a bool per class - Avalonia's Classes
             is not bindable, so the view model exposes IsPassed/IsFailed/... rather than a string. -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
        </Style>

        <Style Selector="Border.pill.passed">
            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}" />
        </Style>
        <Style Selector="Border.pill.passed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
        </Style>

        <Style Selector="Border.pill.failed">
            <Setter Property="Background" Value="{DynamicResource StatusServerErrorBg}" />
        </Style>
        <Style Selector="Border.pill.failed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusServerErrorFg}" />
        </Style>

        <Style Selector="Border.pill.errored">
            <Setter Property="Background" Value="{DynamicResource StatusConnFailedBg}" />
        </Style>
        <Style Selector="Border.pill.errored TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusConnFailedFg}" />
        </Style>

        <!-- A non-2xx nobody asserted on: neither green nor red, because the run does not fail over it
             and it is still the thing a reader is most likely scanning for. -->
        <Style Selector="Border.pill.unexpected">
            <Setter Property="Background" Value="{DynamicResource StatusClientErrorBg}" />
        </Style>
        <Style Selector="Border.pill.unexpected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusClientErrorFg}" />
        </Style>

        <Style Selector="Border.pill.skipped">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- The answer differs from what it was compared against. Drawn as a WARNING rather than as a
             failure: the request itself passed every assertion it had, and the two are separate axes
             (see StepReport.Comparison) - but it is never green, because the run is not green. -->
        <Style Selector="Border.pill.differing">
            <Setter Property="Background" Value="{DynamicResource StatusClientErrorBg}" />
        </Style>
        <Style Selector="Border.pill.differing TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusClientErrorFg}" />
        </Style>

        <!-- Nothing to compare against. Red, and deliberately: "no snapshot, therefore fine" is how a
             suite silently stops testing, so it reads as the failure it is. -->
        <Style Selector="Border.pill.uncomparable">
            <Setter Property="Background" Value="{DynamicResource StatusServerErrorBg}" />
        </Style>
        <Style Selector="Border.pill.uncomparable TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusServerErrorFg}" />
        </Style>

        <!-- Cleanup that did not do its job. Amber, not red: it cannot fail the run, and a red row in
             a report that says "passed" is a report arguing with itself. -->
        <Style Selector="Border.pill.cleanup">
            <Setter Property="Background" Value="{DynamicResource StatusClientErrorBg}" />
        </Style>
        <Style Selector="Border.pill.cleanup TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusClientErrorFg}" />
        </Style>

        <Style Selector="Border.summary">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
        </Style>
        <Style Selector="Border.summary.ok">
            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}" />
        </Style>
        <Style Selector="Border.summary.bad">
            <Setter Property="Background" Value="{DynamicResource StatusServerErrorBg}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <!-- What is being run, and against what. The environment is named because it decides every
             {{variable}} in the collection, and running the right requests against the wrong
             environment is the mistake this window is most able to prevent. -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding Target}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                <Run Text="Environment:" />
                <Run Text="{Binding EnvironmentName}" />
            </TextBlock>
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Filter by name (blank runs everything)"
                             Text="{Binding NameFilter}"
                             IsEnabled="{Binding !IsRunning}" />
                    <Button Grid.Column="1" Classes="primary-btn"
                            Content="Run" Command="{Binding RunCommand}"
                            IsVisible="{Binding !IsRunning}" />
                    <Button Grid.Column="2" Classes="secondary-btn"
                            Content="Cancel" Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsRunning}" />
                </Grid>

                <!-- What judges each response. Its own row, above the incidental options, because it
                     is the question that decides what the run MEANS - and because "compare against
                     the snapshot" and "compare with production" used to be two separate windows. -->
                <Grid ColumnDefinitions="Auto,220,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="Judge by" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Oracles}"
                              SelectedItem="{Binding SelectedOracle}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !IsRunning}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectionRunViewModel+RunOracleChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Recording is its own button, never something Run does when it finds nothing
                         recorded: a snapshot that writes itself on the first failing run tests
                         nothing ever again, and does it silently. -->
                    <Button Grid.Column="2" Classes="secondary-btn"
                            Content="Record snapshots"
                            Command="{Binding RecordSnapshotsCommand}"
                            IsVisible="{Binding CanRecord}"
                            ToolTip.Tip="Send everything once and store the answers as the snapshots later runs are compared against. Overwrites whatever is there." />

                    <CheckBox Grid.Column="3"
                              Content="Share across environments"
                              IsChecked="{Binding ShareSnapshots}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="One snapshot every environment uses, instead of one per environment. Right when the environments hold the same data; otherwise a data difference reads as a regression." />
                </Grid>

                <TextBlock Text="{Binding OracleDescription}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />

                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Stop at the first failure"
                              IsChecked="{Binding StopOnFailure}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="Useful for a chain: when the first request is a login the rest depend on, carrying on just produces the same failure many times."
                              Margin="0,0,16,0" />
                    <CheckBox Content="Record history"
                              IsChecked="{Binding RecordHistory}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="Off by default: history is capped per request, so repeated runs would evict the sends you made by hand."
                              Margin="0,0,16,0" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Delay (ms)" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                        <NumericUpDown Value="{Binding DelayMilliseconds}"
                                       Minimum="0" Maximum="60000" Increment="100"
                                       FormatString="0" Width="110"
                                       IsEnabled="{Binding !IsRunning}"
                                       ToolTip.Tip="Space out the requests for a rate-limited API, where running faster than the limit turns passing requests into 429s." />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- The plan. Every row exists from the start, so the window can answer "how much is left?"
             before it has finished. -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgResponsePanel}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Steps}" Margin="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunStepRowViewModel">
                            <!-- The name gets its own share of the width rather than whatever the
                                 detail leaves: a compared row detail names the file it was judged
                                 against, which is long enough to squeeze the name off the row
                                 entirely - and the name is what the reader is looking for. -->
                            <Grid ColumnDefinitions="34,Auto,2*,3*" Margin="8,5" ColumnSpacing="10">

                                <TextBlock Grid.Column="0" Text="{Binding Order}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />

                                <Border Grid.Column="1" Classes="pill"
                                        Classes.passed="{Binding IsPassed}"
                                        Classes.failed="{Binding IsFailed}"
                                        Classes.errored="{Binding IsErrored}"
                                        Classes.skipped="{Binding IsSkipped}"
                                        Classes.unexpected="{Binding IsUnexpectedStatus}"
                                        Classes.cleanup="{Binding IsCleanupProblem}"
                                        Classes.differing="{Binding IsDiffering}"
                                        Classes.uncomparable="{Binding IsUncomparable}"
                                        VerticalAlignment="Center">
                                    <Panel>
                                        <TextBlock Text="{Binding StatusText}"
                                                   IsVisible="{Binding !IsRunning}" />
                                        <TextBlock Text="…" IsVisible="{Binding IsRunning}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />

                                        <!-- A failing cleanup row is not a failing test, and a reader
                                             scanning a red run has to tell the two apart. -->
                                        <TextBlock Text="cleanup"
                                                   IsVisible="{Binding IsTeardown}"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   ToolTip.Tip="Runs after the tested steps whatever happened to them, and never changes the verdict" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Error}"
                                               IsVisible="{Binding Error, Converter={x:Static avc:ObjectConverters.IsNotNull}}"
                                               Foreground="{DynamicResource StatusConnFailedFg}"
                                               FontSize="11" TextWrapping="Wrap" />

                                    <!-- Only FAILED assertions are listed: a report's job is to point at
                                         what needs attention, and the counts already say how many
                                         passed. -->
                                    <ItemsControl ItemsSource="{Binding FailedAssertions}"
                                                  IsVisible="{Binding HasFailedAssertions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource StatusServerErrorFg}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Margin="0,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                    <!-- "2 differences from Staging.json" is where the question
                                         starts, not where it ends. Only on rows that kept both
                                         bodies, so it never offers to open nothing. -->
                                    <Button DockPanel.Dock="Right"
                                            Classes="secondary-btn"
                                            Content="Open"
                                            FontSize="11"
                                            Padding="8,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding CanShowDifferences}"
                                            ToolTip.Tip="Show what it was compared against, beside what came back"
                                            Command="{Binding $parent[ItemsControl].((vm:CollectionRunViewModel)DataContext).ShowDifferencesCommand}"
                                            CommandParameter="{Binding}" />

                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Detail}"
                                               FontFamily="Cascadia Code,Consolas,monospace" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status while running; the verdict afterwards. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0" ColumnSpacing="10">
            <Border Grid.Column="0" Classes="summary"
                    Classes.ok="{Binding IsVerdictOk}"
                    Classes.bad="{Binding IsVerdictBad}"
                    IsVisible="{Binding HasVerdict}">
                <TextBlock Text="{Binding Summary}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding Status}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
