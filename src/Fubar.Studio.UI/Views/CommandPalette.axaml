<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fubar.Studio.UI.ViewModels"
        xmlns:avc="using:Avalonia.Data.Converters"
        x:Class="Fubar.Studio.UI.Views.CommandPalette"
        x:DataType="vm:CommandPaletteViewModel"
        Width="620" Height="420"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BgEditorCanvas}"
        Title="Commands">

    <Window.Styles>
        <!-- The characters the query actually matched. Weight as well as colour: the accent alone is
             hard to follow across a list, and on a selected row the highlight sits on a filled
             background where colour contrast is at its weakest. -->
        <Style Selector="TextBlock.matched">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Styles>

    <!-- Deliberately plain, and deliberately keyboard-only. A palette is used with the hands already
         on the keyboard; anything that needs a pointer belongs on a toolbar instead. -->
    <Grid RowDefinitions="Auto,*" Margin="12">

        <TextBox Grid.Row="0"
                 x:Name="QueryBox"
                 Text="{Binding Query}"
                 PlaceholderText="Type a command, or a request name"
                 FontSize="14"
                 Margin="0,0,0,10" />

        <ListBox Grid.Row="1"
                 x:Name="ResultList"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PaletteRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="24">
                        <!-- The title in pieces, so the matched characters can be drawn differently -
                             Avalonia has no bindable inline collection, so a strip of TextBlocks it
                             is. Clipped rather than ellipsed: a long request name would otherwise push
                             the category and the gesture off the right edge, and those are what tell
                             two similarly named entries apart. -->
                        <ItemsControl Grid.Column="0"
                                      ItemsSource="{Binding Runs}"
                                      ClipToBounds="True"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PaletteRun">
                                    <TextBlock Text="{Binding Text}"
                                               Classes.matched="{Binding IsMatch}"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Category}"
                                   VerticalAlignment="Center"
                                   Margin="10,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <!-- The gesture beside the entry, so using the palette teaches the shortcut
                             that would have avoided it. -->
                        <Border Grid.Column="2"
                                IsVisible="{Binding Gesture, Converter={x:Static avc:StringConverters.IsNotNullOrEmpty}}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Gesture}"
                                       FontSize="10"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
