<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fubar.Studio.UI.ViewModels"
             xmlns:fc="using:Fubar.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="Fubar.Studio.UI.Views.BatchEditorView"
             x:DataType="vm:BatchEditorViewModel"
             Background="{DynamicResource BgEditorCanvas}">

    <!-- One batches/<name>.json (docs/spec-endpoints.md §9.7). Until this existed a batch was made
         from the Left Pane and then edited as JSON, which meant its one real hazard - a step naming
         an endpoint path that is not there - could only be found by running it. -->


    <UserControl.Styles>
        <!-- A step whose target the workspace no longer has. It is not removed and not hidden: the
             planner turns one into a step that ERRORS rather than skipping it, and this is the same
             fact said earlier. -->
        <Style Selector="ComboBox.unresolved">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusClientErrorFg}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="TextBlock.columnhead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20,16">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Batch"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{Binding Name}" Width="240" FontWeight="Bold" FontSize="14"
                         ToolTip.Tip="The file's name too - this is what @name means on the command line, so saving a new one renames the file" />
                <Button Content="Save" Classes="primary-btn" Command="{Binding SaveCommand}" />

                <fc:StatusDot Diameter="6"
                              Background="{DynamicResource StatusDirty}"
                              IsVisible="{Binding IsDirty}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Unsaved changes" />
            </StackPanel>

            <TextBox Text="{Binding Description}"
                     PlaceholderText="What occasion this is for - &quot;the smoke test&quot; still owes the reader what it proves" />

            <!-- What judges it, and against what. The three choices and their sentences are the Run
                 window's own, because they are the same three. -->
            <Border Background="{DynamicResource BgHeader}" CornerRadius="4" Padding="10,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Judged by" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding Oracles}"
                                  SelectedItem="{Binding SelectedOracle}"
                                  MinWidth="180" />

                        <TextBlock Text="on" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding EnvironmentNames}"
                                  SelectedItem="{Binding PrimaryEnvironment}"
                                  MinWidth="150"
                                  ToolTip.Tip="Leave empty to use whichever environment is active when it runs - which is what makes one batch usable from the toolbar and from CI" />

                        <TextBlock Text="versus" VerticalAlignment="Center"
                                   IsVisible="{Binding NeedsOtherEnvironment}"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding EnvironmentNames}"
                                  SelectedItem="{Binding OtherEnvironment}"
                                  MinWidth="150"
                                  IsVisible="{Binding NeedsOtherEnvironment}" />
                    </StackPanel>

                    <TextBlock Classes="hint" Text="{Binding OracleDescription}" />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Stop at the first failure"
                                  IsChecked="{Binding StopOnFailure}"
                                  ToolTip.Tip="The right setting for a chain - and the reason cleanup belongs below rather than as a last step" />

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Wait between steps" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <NumericUpDown Value="{Binding DelayMilliseconds}"
                                           Minimum="0"
                                           Maximum="60000"
                                           Increment="100"
                                           FormatString="0"
                                           Width="120" />
                            <TextBlock Text="ms" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="6">

                <!-- The items. Each is a FILE in this batch's directory, and the order is their file
                     names', naturally sorted - request-2 before request-10 - so reordering a batch is
                     renaming a file and there is no index anywhere to disagree with the disk. -->

                <TextBlock Text="ITEMS" Classes="columnhead" Margin="6,4,0,0" />
                <TextBlock Classes="hint" Margin="6,0,0,4"
                           Text="One way of calling this endpoint each, with its own body. Sent in file-name order." />

                <TextBlock Classes="hint" Margin="6,4"
                           IsVisible="{Binding !HasItems}"
                           Text="No items yet. Add one, and give it a body." />

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BatchItemRowViewModel">
                            <Border BorderBrush="{DynamicResource BorderEditor}" BorderThickness="0,0,0,1"
                                    Padding="6,5">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <!-- Whether there is a recorded answer decides whether judging by
                                         snapshot means anything for this item, which was previously
                                         only discoverable by running it. -->
                                    <TextBlock Grid.Column="1" Text="{Binding SnapshotText}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />

                                    <Button Grid.Column="2" Classes="secondary-btn"
                                            Content="Open" FontSize="11" Padding="8,2"
                                            ToolTip.Tip="Edit this item's body, assertions and captures"
                                            Command="{Binding $parent[ItemsControl].((vm:BatchEditorViewModel)DataContext).OpenItemCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,6,0,20">
                    <Button Classes="secondary-btn"
                            Content="+ Add item"
                            Command="{Binding AddItemCommand}" />

                    <TextBlock Classes="hint" Text="{Binding ItemSummary}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
