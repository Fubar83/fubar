<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
        x:Class="Fubar.Studio.UI.Views.CurlImportDialog"
        Title="Import from curl"
        Width="640" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSidebar}">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="Paste a curl command"
                   FontWeight="Bold"
                   FontSize="15"
                   Foreground="{DynamicResource TextPrimary}" />

        <TextBlock Grid.Row="1"
                   Text="Method, URL, headers, query and body (-d / --data, -F, -u basic auth) are imported into a new request."
                   Margin="0,4,0,10"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />

        <TextBox Grid.Row="2"
                 x:Name="CurlInput"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 FontSize="12"
                 PlaceholderText="curl 'https://api.example.com/v1/users' -H 'Authorization: Bearer {{token}}'" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel" Classes="secondary-btn" Click="Cancel_Click" />
            <Button Content="Import" Classes="primary-btn" Click="Import_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
