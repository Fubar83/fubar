<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fc="using:Fubar.Controls"
        xmlns:dv="using:Fubar.Diff.Controls.Views"
        xmlns:dvm="using:Fubar.Diff.Controls.ViewModels"
        xmlns:vm="using:Fubar.Studio.UI.ViewModels"
        xmlns:cmp="using:Fubar.Studio.Core.Comparison"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Fubar.Studio.UI.Views.DiffPreviewDialog"
        x:DataType="vm:DiffPreviewViewModel"
        Title="{Binding Title}"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgEditorCanvas}">

    <Window.KeyBindings>
        <!-- Same gestures as Fubar Diff, so the view behaves identically wherever it is hosted. -->
        <KeyBinding Gesture="F8" Command="{Binding Pane.NextChangeCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding Pane.PreviousChangeCommand}" />
        <KeyBinding Gesture="Alt+Down" Command="{Binding Pane.NextChangeCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding Pane.PreviousChangeCommand}" />

    </Window.KeyBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LeftLabel}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RightLabel}"
                           Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />

                <fc:Toolbar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Button Classes="toolbar-btn" Content="◀ Prev" ToolTip.Tip="Previous change (F7 or Alt+Up)"
                            Command="{Binding Pane.PreviousChangeCommand}"
                            IsEnabled="{Binding Pane.HasChanges}" />
                    <Button Classes="toolbar-btn" Content="Next ▶" ToolTip.Tip="Next change (F8 or Alt+Down)"
                            Command="{Binding Pane.NextChangeCommand}"
                            IsEnabled="{Binding Pane.HasChanges}" />

                    <!-- Ignoring from the side-by-side view, so the responses stay on screen while
                         rules are added. Acts on the current difference, which is why it needs one
                         selected - Prev/Next or the diff map pick it. -->
                    <Button Classes="toolbar-btn" Content="⊘ Ignore this field"
                            Margin="8,0,0,0"
                            ToolTip.Tip="{Binding Pane.IgnoreCurrentTooltip}"
                            IsVisible="{Binding Pane.CanIgnorePaths}"
                            IsEnabled="{Binding Pane.CanIgnoreCurrent}"
                            Command="{Binding Pane.IgnorePathCommand}"
                            CommandParameter="{Binding Pane.CurrentIgnorePath}" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- Comparison options, matching what Fubar Diff's own toolbar offers - these were
                         missing here entirely, so a Studio user had no way to loosen a comparison even
                         for one session. All of them sit behind this one button rather than spilling
                         two checkboxes into a dialog toolbar that is already carrying navigation, the
                         ignore action, the detail pane and the view switch. Each edits the REQUEST
                         level of the hierarchy, so ticking one overrides whatever the folder or global
                         level said; each tooltip names where the current value came from. -->
                    <Button Classes="toolbar-btn" Content="Settings ▾" Margin="8,0,0,0"
                            ToolTip.Tip="Comparison options, and where each one comes from">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="10" MinWidth="300" Margin="2">
                                    <TextBlock Text="COMPARISON SETTINGS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="Each setting is inherited from your global defaults, then any folder, then this request - and each can be overridden on its own." />

                                    <CheckBox Content="Ignore leading/trailing whitespace" IsChecked="{Binding IgnoreWhitespace}"
                                              ToolTip.Tip="{Binding IgnoreWhitespaceSource, StringFormat='Ignore leading/trailing whitespace ({0})'}" />
                                    <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}"
                                              ToolTip.Tip="{Binding IgnoreCaseSource, StringFormat='Ignore case ({0})'}" />
                                    <CheckBox Content="Reformat for display" IsChecked="{Binding NormalizeStructure}"
                                              ToolTip.Tip="{Binding NormalizeStructureSource, StringFormat='Pretty-print JSON/XML in the Text view ({0})'}" />
                                    <CheckBox Content="Report key order" IsChecked="{Binding ReportPropertyOrder}"
                                              ToolTip.Tip="{Binding ReportPropertyOrderSource, StringFormat='JSON objects are unordered, so reordering is not a difference by default ({0})'}" />
                                    <CheckBox Content="Compare arrays by position" IsChecked="{Binding MatchArraysByPosition}"
                                              ToolTip.Tip="{Binding MatchArraysByPositionSource, StringFormat='Match array elements by index instead of by an identity key ({0})'}" />
                                    <CheckBox Content="Treat null and missing as the same" IsChecked="{Binding IgnoreNullVsMissing}"
                                              ToolTip.Tip="{Binding IgnoreNullVsMissingSource, StringFormat='An explicit null and an absent property compare equal ({0})'}" />

                                    <Button Classes="secondary-btn" Content="Reset to inherited"
                                            ToolTip.Tip="Drop this request's overrides and go back to what it inherits"
                                            IsEnabled="{Binding HasOverrides}"
                                            Command="{Binding ResetOverridesCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <CheckBox Content="Diff pane"
                              ToolTip.Tip="Show the current difference close up, below the panes"
                              IsChecked="{Binding Pane.IsDetailVisible}"
                              VerticalAlignment="Center" />

                    <fc:Divider Orientation="Vertical" Margin="8,0" />

                    <!-- Only offered when the semantic pass ran; the tree has nothing to show for
                         anything that is not JSON. -->
                    <fc:SegmentedControl ItemsSource="{x:Static dvm:DiffPaneViewModel.ViewModeOptions}"
                                         SelectedItem="{Binding Pane.ViewMode}"
                                         IsVisible="{Binding Pane.IsSemantic}" />

                    <fc:Spinner IsVisible="{Binding IsBusy}" Margin="8,0,0,0" />
                </fc:Toolbar>
            </Grid>
        </Border>

        <!-- Ignore rules. Only present for a comparison that has somewhere to keep them - the OpenAPI
             import preview passes no context and never shows this strip. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding ShowSettings}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Ignoring" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />

                <TextBlock Grid.Column="1"
                           Text="nothing yet — select a difference and use “Ignore this field”, or “ignore” in the Tree view"
                           Foreground="{DynamicResource TextSecondary}"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IgnoredPaths.Count}" />

                <ItemsControl Grid.Column="1" ItemsSource="{Binding IgnoredPaths}"
                              IsVisible="{Binding !!IgnoredPaths.Count}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{DynamicResource BgSelected}"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,6,2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                               FontSize="11" VerticalAlignment="Center" />
                                    <Button Classes="toolbar-btn" Content="✕" Padding="3,0"
                                            ToolTip.Tip="Stop ignoring this path"
                                            Command="{Binding $parent[Window].((vm:DiffPreviewViewModel)DataContext).RemoveIgnoreCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Changes apply immediately but are session-only until saved: adjusting a
                     comparison is often exploratory, and rewriting request.json on every click would
                     not be. WHERE to save is the user's choice, because the same three levels the
                     settings are read from are the three they can be written back to - a rule about
                     one endpoint belongs on the request, one about a whole service on its folder, and
                     a personal reading preference globally. -->
                <SplitButton Grid.Column="2" Content="Save to request"
                             ToolTip.Tip="Remember these settings on the request, so they always apply"
                             IsVisible="{Binding CanSaveSettings}"
                             IsEnabled="{Binding SettingsDirty}"
                             Command="{Binding SaveSettingsCommand}"
                             CommandParameter="{x:Static cmp:ComparisonScope.Request}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Save to request"
                                      Command="{Binding SaveSettingsCommand}"
                                      CommandParameter="{x:Static cmp:ComparisonScope.Request}" />
                            <MenuItem Header="{Binding SaveToFolderLabel}"
                                      IsVisible="{Binding CanSaveToFolder}"
                                      Command="{Binding SaveSettingsCommand}"
                                      CommandParameter="{x:Static cmp:ComparisonScope.Folder}" />
                            <MenuItem Header="Save as global defaults"
                                      Command="{Binding SaveSettingsCommand}"
                                      CommandParameter="{x:Static cmp:ComparisonScope.Global}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary-btn" Content="Close"
                        Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Panel>
            <fc:EmptyState Title="Nothing to compare"
                           Description="There is no content on either side."
                           IsVisible="{Binding Pane.LeftDocument, Converter={x:Static ObjectConverters.IsNull}}" />

            <dv:DiffView DataContext="{Binding Pane}" IsVisible="{Binding IsSideBySideViewVisible}" />
            <dv:JsonView DataContext="{Binding Pane}" IsVisible="{Binding IsJsonViewVisible}" />
        </Panel>
    </DockPanel>
</Window>
