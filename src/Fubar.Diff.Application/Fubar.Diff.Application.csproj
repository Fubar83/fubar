<Project Sdk="Microsoft.NET.Sdk">

  <!-- Use-case / orchestration layer. Depends on Fubar.Diff.Core ONLY - never on Infrastructure or
       the UI. Enforced by Fubar.Diff.Architecture.Tests. -->
  <PropertyGroup>
    <RootNamespace>Fubar.Diff.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fubar.Diff.Core\Fubar.Diff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the line-length cap on character diffing can be tested at its real value rather than at a
         number a test made up - see FileComparisonService.MaxInlineDiffLength. -->
    <InternalsVisibleTo Include="Fubar.Diff.Application.Tests" />
  </ItemGroup>

</Project>
