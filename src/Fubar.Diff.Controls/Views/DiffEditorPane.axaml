<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="Fubar.Diff.Controls.Views.DiffEditorPane">

    <!-- One side of the diff. Read-only until the host says otherwise (IsEditable), because the
         document contains filler rows to keep the panes aligned and so is NOT the file's text. An
         editable pane earns the right to be edited by tracking those fillers with anchors, so the
         file's own lines can be handed back afterwards - see ReadFileLines. Every pane that shows
         something other than a plain text file, the close-ups and the hex view included, leaves it
         off. -->
    <ae:TextEditor x:Name="Editor"
                   IsReadOnly="True"
                   ShowLineNumbers="False"
                   FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="12.5"
                   Background="Transparent"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto" />

</UserControl>
