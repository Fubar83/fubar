<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="using:Fubar.Controls"
             xmlns:vm="using:Fubar.Diff.Controls.ViewModels"
             x:Class="Fubar.Diff.Controls.Views.JsonTreeView"
             x:Name="Root"
             x:DataType="vm:DiffPaneViewModel">

    <UserControl.Styles>
        <!-- Same palette tokens as the editors' line tints, so a change reads the same colour in
             either view. -->
        <Style Selector="TextBlock.inserted">
            <Setter Property="Foreground" Value="{DynamicResource MethodPostBrush}" />
        </Style>
        <Style Selector="TextBlock.deleted">
            <Setter Property="Foreground" Value="{DynamicResource MethodDeleteBrush}" />
        </Style>
        <Style Selector="TextBlock.modified">
            <Setter Property="Foreground" Value="{DynamicResource MethodPutBrush}" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.summary">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <!-- Last, so it wins over the change colours above: an ignored row is still shown, but must
             read as quieter than everything that was not ignored. -->
        <Style Selector="TextBlock.ignored">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>

    </UserControl.Styles>

    <Panel>
        <fc:EmptyState Title="No structural changes"
                       Description="The two documents are the same once formatting and ordering are ignored."
                       IsVisible="{Binding !SemanticTree.Count}" />

        <!-- SelectedItem is two-way so the Hybrid view's Prev/Next can drive the tree's selection
             (DiffPaneViewModel.CurrentTreeNode) as well as read it when the user clicks a row - Text
             and Tree mode never set CurrentTreeNode, so this binding is otherwise inert for them. -->
        <fc:TreeView x:Name="Tree"
                     ItemsSource="{Binding SemanticTree}"
                     SelectedItem="{Binding CurrentTreeNode, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsVisible="{Binding !!SemanticTree.Count}">
            <!-- IsExpanded is bound to the ROW rather than left to the container, so navigation can
                 open the way to a difference five levels down. TwoWay because expanding by hand is the
                 row's own state, and a one-way binding would have the next navigation silently
                 disagree with what the user just did - the same reason the View menu's two genuine
                 two-way MenuItems say so explicitly. -->
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:JsonChangeNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:JsonChangeNodeViewModel">
                    <!-- Transparent rather than unset: an unset background is not hit-testable, so a
                         click landing on the padding between the label and the next control would
                         reach nothing. The row itself is already full width and already takes hover,
                         which is what makes the whole line one target - see JsonTreeView.axaml.cs. -->
                    <Border Background="Transparent" HorizontalAlignment="Stretch">

                        <!-- Only on array rows, because it is the only row where there is a real
                             question: whether the elements have identity, and which field carries it.
                             Every array row in this tree has differences beneath it by construction -
                             the tree is built from change paths - so there is no separate "does this
                             one differ" test to make. -->
                        <Border.ContextMenu>
                            <ContextMenu IsVisible="{Binding IsArray}">
                                <!-- The heading says what the rule for this array currently IS, because
                                     that is the first thing anyone wants on right-clicking a list and
                                     the marks below it only answer once the submenu is open. An array
                                     nobody has spoken about reads "Matched by position". -->
                                <MenuItem Header="{Binding ArrayCurrentDescription}" IsEnabled="False" />
                                <Separator />

                                <!-- The list is built per row: by position, then ignoring order, then
                                     the suggested key labelled as such, then every other field that
                                     would actually work as one. A field that is missing somewhere, or
                                     repeated, is not offered - it would silently fail to match and
                                     produce a diff that looks like data loss.

                                     "Ignore order" is offered for EVERY array including one of plain
                                     strings, which is the shape that had no answer here before: a set
                                     of tags or roles has no field to be keyed by, so it could only ever
                                     be compared by position. -->
                                <MenuItem Header="Compare this list" ItemsSource="{Binding ArrayKeyOptions}">
                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="vm:ArrayKeyOption">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="Command"
                                                    Value="{Binding #Root.((vm:DiffPaneViewModel)DataContext).ChooseArrayKeyCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />

                                            <!-- Radio rather than a check: these are one mutually
                                                 exclusive setting, and exactly one is always in force.
                                                 IsCurrent was computed for this and then bound to
                                                 nothing at all, so the menu offered four options and
                                                 said nothing about which one you were already on.
                                                 One-way: the option is a record and the choice is made
                                                 by the command, not by toggling the item. -->
                                            <Setter Property="ToggleType" Value="Radio" />
                                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>
                                </MenuItem>

                                <!-- For identity the scanner cannot see: a field only some elements
                                     have today, or one nested deeper than it looks for. Accepts a
                                     dotted path, so "meta.id" works as well as "id". -->
                                <MenuItem Header="Match by another field…"
                                          Command="{Binding #Root.((vm:DiffPaneViewModel)DataContext).RequestCustomArrayKeyCommand}"
                                          CommandParameter="{Binding Path}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="path" Text="{Binding Label}" VerticalAlignment="Center"
                                   Classes.ignored="{Binding IsIgnored}" />
                        <TextBlock Classes="summary"
                                   Classes.inserted="{Binding IsInserted}"
                                   Classes.deleted="{Binding IsDeleted}"
                                   Classes.modified="{Binding IsModified}"
                                   Classes.ignored="{Binding IsIgnored}"
                                   Text="{Binding Summary}"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="ignored" Margin="12,0,0,0" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Opacity="0.6"
                                   IsVisible="{Binding IsIgnored}" />

                        <!-- Two conditions, nested rather than combined with a converter: the outer is
                             whether the HOST can hold a rule at all (Fubar Diff compares files and
                             cannot, so it never shows this), the inner is whether this ROW is a
                             difference. Grouping rows like `items` or `[0]` show no change of their
                             own, and offering to ignore one invites hiding a whole subtree from a
                             click that does not look like it does that. -->
                        <Panel IsVisible="{Binding #Root.((vm:DiffPaneViewModel)DataContext).CanIgnorePaths}">
                            <Button Classes="toolbar-btn"
                                    Content="ignore"
                                    Margin="12,0,0,0"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Never report differences at this path"
                                    IsEnabled="{Binding CanIgnore}"
                                    IsVisible="{Binding ShowIgnore}"
                                    Command="{Binding #Root.((vm:DiffPaneViewModel)DataContext).IgnorePathCommand}"
                                    CommandParameter="{Binding IgnorePath}" />
                        </Panel>
                    </StackPanel>
                    </Border>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </fc:TreeView>
    </Panel>
</UserControl>
