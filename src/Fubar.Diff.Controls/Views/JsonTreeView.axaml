<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="using:Fubar.Controls"
             xmlns:vm="using:Fubar.Diff.Controls.ViewModels"
             x:Class="Fubar.Diff.Controls.Views.JsonTreeView"
             x:Name="Root"
             x:DataType="vm:DiffPaneViewModel">

    <UserControl.Styles>
        <!-- Same palette tokens as the editors' line tints, so a change reads the same colour in
             either view. -->
        <Style Selector="TextBlock.inserted">
            <Setter Property="Foreground" Value="{DynamicResource MethodPostBrush}" />
        </Style>
        <Style Selector="TextBlock.deleted">
            <Setter Property="Foreground" Value="{DynamicResource MethodDeleteBrush}" />
        </Style>
        <Style Selector="TextBlock.modified">
            <Setter Property="Foreground" Value="{DynamicResource MethodPutBrush}" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.summary">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <!-- Last, so it wins over the change colours above: an ignored row is still shown, but must
             read as quieter than everything that was not ignored. -->
        <Style Selector="TextBlock.ignored">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <fc:EmptyState Title="No structural changes"
                       Description="The two documents are the same once formatting and ordering are ignored."
                       IsVisible="{Binding !SemanticTree.Count}" />

        <fc:TreeView ItemsSource="{Binding SemanticTree}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsVisible="{Binding !!SemanticTree.Count}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:JsonChangeNodeViewModel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="path" Text="{Binding Label}" VerticalAlignment="Center"
                                   Classes.ignored="{Binding IsIgnored}" />
                        <TextBlock Classes="summary"
                                   Classes.inserted="{Binding IsInserted}"
                                   Classes.deleted="{Binding IsDeleted}"
                                   Classes.modified="{Binding IsModified}"
                                   Classes.ignored="{Binding IsIgnored}"
                                   Text="{Binding Summary}"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="ignored" Margin="12,0,0,0" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Opacity="0.6"
                                   IsVisible="{Binding IsIgnored}" />

                        <!-- Only when the host supplied a command - Fubar Diff compares files, which
                             have nowhere to remember a rule, so it never shows this. On a grouping
                             row the rule covers the whole subtree, which is why it is offered there
                             too rather than only on leaves. -->
                        <Button Classes="toolbar-btn"
                                Content="ignore"
                                Margin="12,0,0,0"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Never report differences at this path"
                                IsEnabled="{Binding CanIgnore}"
                                IsVisible="{Binding #Root.((vm:DiffPaneViewModel)DataContext).CanIgnorePaths}"
                                Command="{Binding #Root.((vm:DiffPaneViewModel)DataContext).IgnorePathCommand}"
                                CommandParameter="{Binding IgnorePath}" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </fc:TreeView>
    </Panel>
</UserControl>
