<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Fubar.Diff.Controls.Views"
             xmlns:vm="using:Fubar.Diff.Controls.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="180"
             x:Class="Fubar.Diff.Controls.Views.DiffDetailPane"
             x:DataType="vm:DiffPaneViewModel">

    <!-- A close-up of just the current difference, the way WinMerge's diff pane works. The main panes
         answer "where are the changes"; this answers "what exactly does this one say", without
         hunting for two blocks that may be a screen apart.

         Stacked - left on top of right - rather than side by side. Side by side is what the main
         panes already do, at full document width; putting the SAME two lines directly one above the
         other instead is what lets the character-level highlight (already the strongest signal
         DiffEditorPane draws) read at a glance, rather than asking the eye to jump a whole pane's
         width to compare two short strings.

         Reuses DiffEditorPane, so the excerpt is character-highlighted and line-numbered by exactly the
         same renderers as the main view - a second rendering path here would be free to disagree with
         the one above it, which is the last thing a close-up should do. Emphasized="True" does two
         things (see DiffLineColors and ChangeLineBackgroundRenderer): it skips the main view's
         full-line wash entirely - a page showing nothing but the current difference has no "where" left
         for a whole-row band to answer - and turns the character-level highlight up to a stronger
         intensity, since it is now the ONLY signal here rather than one layered on top of a tint. -->

    <Border Background="{DynamicResource BgHeader}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,1,0,0">

        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding DetailCaption}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       Margin="8,4" />

            <Grid RowDefinitions="*,1,*">
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="Left"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="10" Margin="8,2" />
                    <views:DiffEditorPane Document="{Binding DetailLeft}" Emphasized="True"
                                          ShowInvisibles="{Binding ShowInvisibles}"
                                          SyntaxExtension="{Binding LeftSyntaxExtension}"
                                          SyntaxHighlighting="{Binding SyntaxHighlighting}" />
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource BorderSubtle}" />

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Right"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="10" Margin="8,2" />
                    <views:DiffEditorPane Document="{Binding DetailRight}" Emphasized="True"
                                          ShowInvisibles="{Binding ShowInvisibles}"
                                          SyntaxExtension="{Binding RightSyntaxExtension}"
                                          SyntaxHighlighting="{Binding SyntaxHighlighting}" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
