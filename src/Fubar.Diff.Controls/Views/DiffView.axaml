<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Fubar.Diff.Controls.Controls"
             xmlns:views="using:Fubar.Diff.Controls.Views"
             xmlns:vm="using:Fubar.Diff.Controls.ViewModels"
             x:Class="Fubar.Diff.Controls.Views.DiffView"
             x:DataType="vm:DiffPaneViewModel">

    <!-- Rows: the side-by-side panes, a drag handle, and the close-up of the current difference.
         The bottom two collapse to zero height when the detail pane is off - code-behind sets the
         row heights, because a GridSplitter needs real definitions to resize and cannot be told to
         ignore a hidden one. -->
    <Grid x:Name="Root" RowDefinitions="*,Auto,260">

        <!-- Two independent editors, kept in step by DiffView.axaml.cs rather than by sharing a
             scroller. Both documents contain filler lines and therefore have the SAME line count,
             which is what makes the sync a plain vertical-offset copy instead of a line-mapping
             problem. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,*">

            <views:DiffEditorPane x:Name="LeftPane"
                                  Grid.Column="0"
                                  Document="{Binding LeftDocument}"
                                  ShowInvisibles="{Binding ShowInvisibles}"
                                  SyntaxExtension="{Binding LeftSyntaxExtension}"
                                  SyntaxHighlighting="{Binding SyntaxHighlighting}" />

            <!-- The map sits between the panes so it reads as belonging to both. -->
            <controls:DiffMap x:Name="Map"
                              Grid.Column="1"
                              Margin="2,0"
                              Hunks="{Binding Hunks}"
                              TotalLines="{Binding TotalLines}"
                              CurrentHunk="{Binding CurrentHunk}"
                              ViewportStart="{Binding ViewportStart}"
                              ViewportLength="{Binding ViewportLength}" />

            <Border Grid.Column="2" Width="1" Background="{DynamicResource BorderSubtle}" />

            <views:DiffEditorPane x:Name="RightPane"
                                  Grid.Column="3"
                                  Document="{Binding RightDocument}"
                                  ShowInvisibles="{Binding ShowInvisibles}"
                                  SyntaxExtension="{Binding RightSyntaxExtension}"
                                  SyntaxHighlighting="{Binding SyntaxHighlighting}" />
        </Grid>

        <GridSplitter x:Name="DetailSplitter"
                      Grid.Row="1"
                      Height="4"
                      ResizeDirection="Rows"
                      Background="{DynamicResource BorderSubtle}" />

        <views:DiffDetailPane x:Name="Detail" Grid.Row="2" />
    </Grid>
</UserControl>
