<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="using:Fubar.Controls"
             xmlns:views="using:Fubar.Diff.Controls.Views"
             xmlns:vm="using:Fubar.Diff.Controls.ViewModels"
             x:Class="Fubar.Diff.Controls.Views.JsonView"
             x:DataType="vm:DiffPaneViewModel">

    <!-- Tree, then both documents shown unaligned - each highlighting only its OWN change span. There
         is no cross-document line alignment here at all, which is what makes this immune to
         formatting and property-order differences: Text mode's usefulness rests on the two sides
         lining up as TEXT, and nothing forces that when one side is minified and the other is not
         (see the alignment fix this view was built alongside). This view sidesteps the question by
         never needing an alignment in the first place - which is also why it is the default for JSON
         (DiffPaneViewModel.Show), with Text as the one fallback for everything else. -->
    <DockPanel>
        <!-- Only for a host with no toolbar of its own - see JsonView.ShowToolbar. A hidden docked
             child takes no space, so this collapses cleanly. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                IsVisible="{Binding $parent[views:JsonView].ShowToolbar}">
            <fc:Toolbar>
                <Button Classes="toolbar-btn" Content="◀ Prev" ToolTip.Tip="Previous difference"
                        Command="{Binding PreviousSemanticChangeCommand}" />
                <Button Classes="toolbar-btn" Content="Next ▶" ToolTip.Tip="Next difference"
                        Command="{Binding NextSemanticChangeCommand}" />

                <TextBlock Text="{Binding JsonCaption}"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </fc:Toolbar>
        </Border>

        <!-- Rows: tree+documents, a drag handle, and the close-up of the current change - the same
             three-row shape DiffView uses for its own detail pane, collapsed the same way (see
             JsonView.axaml.cs) when the "Diff pane" toggle is off. -->
        <Grid x:Name="Root" RowDefinitions="*,Auto,260">
            <Grid Grid.Row="0" ColumnDefinitions="280,4,*,1,*">
                <!-- The same tree control the old standalone Tree mode used - same ignore affordances,
                     same tinting - clicking a row here is a second way to navigate, alongside Prev/Next. -->
                <views:JsonTreeView Grid.Column="0" />

                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderSubtle}" />

                <!-- The pretty toggle sits ON the document rather than in the toolbar, because it is
                     about THIS side: a minified file next to a formatted one is the case it exists
                     for, and a single toolbar button could not say which of the two it meant. Hidden
                     when the host cannot reformat - re-deriving the highlight spans against the new
                     text needs a parser, which not every host has. -->
                <Panel Grid.Column="2">
                    <!-- Changes as well as HighlightSpan: every difference in the document is marked
                         quietly, the current one strongly. Showing only the current one left a
                         document with eleven differences displaying one, with no way to see where the
                         others were short of pressing Next eleven times. -->
                    <views:RawJsonPane Text="{Binding LeftRawText}"
                                       Changes="{Binding SemanticChanges}"
                                       Side="Left"
                                       HighlightSpan="{Binding LeftHighlightSpan}" />

                    <ToggleButton Classes="toolbar-btn"
                                  Content="Pretty"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,4,16,0" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Re-lay-out this document for reading. Changes nothing about the comparison, and nothing on disk."
                                  IsVisible="{Binding CanReformat}"
                                  IsChecked="{Binding PrettyLeft}" />
                </Panel>

                <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderSubtle}" />

                <Panel Grid.Column="4">
                    <views:RawJsonPane Text="{Binding RightRawText}"
                                       Changes="{Binding SemanticChanges}"
                                       Side="Right"
                                       HighlightSpan="{Binding RightHighlightSpan}" />

                    <ToggleButton Classes="toolbar-btn"
                                  Content="Pretty"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,4,16,0" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Re-lay-out this document for reading. Changes nothing about the comparison, and nothing on disk."
                                  IsVisible="{Binding CanReformat}"
                                  IsChecked="{Binding PrettyRight}" />
                </Panel>
            </Grid>

            <GridSplitter x:Name="DetailSplitter"
                          Grid.Row="1"
                          Height="4"
                          ResizeDirection="Rows"
                          Background="{DynamicResource BorderSubtle}" />

            <views:JsonDetailPane x:Name="Detail" Grid.Row="2" />
        </Grid>
    </DockPanel>
</UserControl>
