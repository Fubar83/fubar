<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reusable, app-agnostic Avalonia component library. Depends only on Avalonia (+ AvaloniaEdit for
       the code editor) - deliberately no reference to any host app, view model, or domain concept, so
       the components drop into any Avalonia app. Consumers add one line to Application.Styles:
       <StyleInclude Source="avares://Fubar.Controls/Themes/Fubar.Controls.axaml" />
       The Themes/*.axaml files are compiled into this assembly by the Avalonia build tasks. -->
  <PropertyGroup>
    <RootNamespace>Fubar.Controls</RootNamespace>
    <AssemblyName>Fubar.Controls</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The library ships XML docs so consumers get IntelliSense on the many members that ARE
         documented (every control has a type-level summary). Backfilling doc comments for the
         remaining StyledProperty fields and StyleKeyOverride/OnXxx overrides is open work; until
         then CS1591 would drown out real warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
  </ItemGroup>

  <ItemGroup>
    <!-- The JSON schema completion engine is internal; expose it to the test project. -->
    <InternalsVisibleTo Include="Fubar.Controls.Tests" />
  </ItemGroup>

</Project>
