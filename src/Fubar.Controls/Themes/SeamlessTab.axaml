<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="using:Fubar.Controls">

    <!-- Shared look for fc:SeamlessTabControl (see SeamlessTabControl.cs).

         Underline tabs: a label per tab with a 2px accent bar under the selected one, and a single
         hairline under the whole strip separating it from the content. No box around any tab and no
         box around the content area.

         This replaced boxed tabs - each tab an outlined rounded rectangle whose bottom edge was
         painted out to merge with a bordered content area below it. That construction was elaborate
         (a full-width seam line drawn behind the tabs, an opaque selected tab covering the segment
         under itself, a -1px margin to make the two meet) and every one of those borders was a line
         on screen doing no work: with one strip in a pane, nothing needs boxing off from anything.
         The panes read as more open for their absence, which is the whole reason.

         The name still fits, and fits better: the seam between tabs and content is gone entirely
         rather than painted over.

         Each host still supplies Background - the colour behind the strip and behind the content.
         BorderEditor / TextPrimary / TextSecondary / AccentBrush / BgHover come from Palette.axaml. -->

    <!-- Tab headers -->

    <Style Selector="fc|SeamlessTabControl TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2,7" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="fc|SeamlessTabControl TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Weight is NOT changed on selection. Bolding the selected tab reflows the strip - every tab to
         its right shifts as the selection moves, which is a distracting amount of motion for a click
         that changed one pane. Colour and the accent bar carry it instead. -->
    <Style Selector="fc|SeamlessTabControl TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Replace Fluent's TabItem template outright: it draws its own accent pill via a separate part
         that ignores the setters above, sized and positioned to its own taste. -->
    <Style Selector="fc|SeamlessTabControl TabItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*,Auto" Background="{TemplateBinding Background}">
                    <ContentPresenter Grid.Row="0"
                                      Content="{TemplateBinding Header}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                    <!-- Always present, transparent when unselected: a bar that appears and disappears
                         would change the strip's height as the selection moves. -->
                    <Border Grid.Row="1"
                            Name="PART_Indicator"
                            Height="2"
                            CornerRadius="1"
                            Background="Transparent" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="fc|SeamlessTabControl TabItem:selected /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="fc|SeamlessTabControl TabItem:pointerover /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource BorderEditor}" />
    </Style>

    <Style Selector="fc|SeamlessTabControl TabItem:selected:pointerover /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The control itself -->

    <Style Selector="fc|SeamlessTabControl">
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <!-- One hairline the full width of the control, under the strip. The selected
                         tab's accent bar sits ON it rather than breaking it, so the line stays
                         continuous however the selection moves. -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        HorizontalAlignment="Left"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>

                    <ContentPresenter Grid.Row="1"
                                      Name="PART_SelectedContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
