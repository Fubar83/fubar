<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Data.Converters"
                    xmlns:fc="using:Fubar.Controls">

    <!-- Feedback controls: Banner (inline message strip) and Spinner (indeterminate loader). Colours
         come from the palette's status tokens. -->

    <ControlTheme x:Key="{x:Type fc:Banner}" TargetType="fc:Banner">
        <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Icon}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   IsVisible="{TemplateBinding Icon, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Message}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding Action}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          IsVisible="{TemplateBinding Action, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Severity=Success]">
            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
        </Style>
        <Style Selector="^[Severity=Warning]">
            <Setter Property="Background" Value="{DynamicResource StatusClientErrorBg}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusClientErrorFg}" />
        </Style>
        <Style Selector="^[Severity=Error]">
            <Setter Property="Background" Value="{DynamicResource StatusServerErrorBg}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusServerErrorFg}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type fc:Spinner}" TargetType="fc:Spinner">
        <Setter Property="Foreground" Value="{DynamicResource BtnSendBg}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Arc Name="PART_Arc"
                     Width="{TemplateBinding Diameter}"
                     Height="{TemplateBinding Diameter}"
                     Stroke="{TemplateBinding Foreground}"
                     StrokeThickness="2"
                     StrokeLineCap="Round"
                     StartAngle="0"
                     SweepAngle="270"
                     RenderTransformOrigin="50%,50%" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Arc#PART_Arc">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

</ResourceDictionary>
