<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- THE shared design-system palette for every app built on Fubar.Controls. This is the single
         source of truth for colour, so all apps that include it look identical and switch Dark/Light
         together. Every colour a view or component binds is a DynamicResource key here, split
         Dark/Light via ResourceDictionary.ThemeDictionaries so an app's runtime RequestedThemeVariant
         switch repaints everything with no restart.

         Consuming app (in Application.Resources, so theme-variant switching works):
             <ResourceInclude Source="avares://Fubar.Controls/Themes/Palette.axaml" />
         then the component/style include (in Application.Styles):
             <StyleInclude Source="avares://Fubar.Controls/Themes/Fubar.Controls.axaml" />

         Legacy "Postman*" keys are kept as aliases pointing at the new tokens so styles not yet
         migrated to the new semantic names keep working unchanged. -->

    <!-- Brand accent - intentionally theme-invariant (signature orange). -->
    <Color x:Key="PostmanOrangeColor">#FF6C37</Color>
    <SolidColorBrush x:Key="PostmanOrangeBrush" Color="{StaticResource PostmanOrangeColor}" />

    <!-- FluentTheme defaults to the OS accent colour (often a jarring red that bleeds into TreeViewItem
         selection, checked toggles, etc.). Pin it, theme-invariant, to the same blue as the Send button
         / valid-variable highlight so every app on this palette gets a consistent accent. -->
    <Color x:Key="SystemAccentColor">#3B82F6</Color>
    <Color x:Key="SystemAccentColorDark1">#2563EB</Color>
    <Color x:Key="SystemAccentColorDark2">#1D4ED8</Color>
    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
    <Color x:Key="SystemAccentColorLight1">#60A5FA</Color>
    <Color x:Key="SystemAccentColorLight2">#93C5FD</Color>
    <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================================================================ -->
        <!-- LIGHT THEME VARIANT                                              -->
        <!-- ================================================================ -->
        <ResourceDictionary x:Key="Light">

            <!-- Sidebar / navigation surfaces -->
            <SolidColorBrush x:Key="BgSidebar" Color="#F8F9FA" />
            <SolidColorBrush x:Key="BgHeader" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgHover" Color="#EAECEF" />
            <SolidColorBrush x:Key="BgSelected" Color="#DCE3F0" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#E1E4E8" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
            <SolidColorBrush x:Key="TextSecondary" Color="#656D76" />

            <SolidColorBrush x:Key="MethodGetBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="MethodPostBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="MethodPutBrush" Color="#D97706" />
            <SolidColorBrush x:Key="MethodDeleteBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="MethodOtherBrush" Color="#9333EA" />

            <SolidColorBrush x:Key="StatusDirty" Color="#D97706" />
            <SolidColorBrush x:Key="BadgeAuth" Color="#0369A1" />
            <SolidColorBrush x:Key="BadgeAuthNone" Color="#94A3B8" />

            <!-- Editor / content canvas -->
            <SolidColorBrush x:Key="BgEditorCanvas" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderEditor" Color="#E1E4E8" />
            <SolidColorBrush x:Key="BtnSendBg" Color="#2563EB" />
            <SolidColorBrush x:Key="VariableValidBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="VariableUndefinedBrush" Color="#D97706" />
            <SolidColorBrush x:Key="BgInheritedRow" Color="#F1F5F9" />

            <!-- Secondary / detail panel -->
            <SolidColorBrush x:Key="BgResponsePanel" Color="#F8F9FA" />
            <SolidColorBrush x:Key="BgResponseHeader" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JsonKey" Color="#0284C7" />
            <SolidColorBrush x:Key="JsonString" Color="#16A34A" />
            <SolidColorBrush x:Key="JsonNumber" Color="#D97706" />
            <SolidColorBrush x:Key="JsonBoolean" Color="#C026D3" />
            <SolidColorBrush x:Key="JsonNull" Color="#64748B" />
            <SolidColorBrush x:Key="SearchHighlight" Color="#FDE047" />

            <!-- Status badge ranges -->
            <SolidColorBrush x:Key="StatusInfoBg" Color="#F1F5F9" />
            <SolidColorBrush x:Key="StatusInfoFg" Color="#475569" />
            <SolidColorBrush x:Key="StatusSuccessBg" Color="#DCFCE7" />
            <SolidColorBrush x:Key="StatusSuccessFg" Color="#15803D" />
            <SolidColorBrush x:Key="StatusRedirectBg" Color="#E0F2FE" />
            <SolidColorBrush x:Key="StatusRedirectFg" Color="#0369A1" />
            <SolidColorBrush x:Key="StatusClientErrorBg" Color="#FFEDD5" />
            <SolidColorBrush x:Key="StatusClientErrorFg" Color="#C2410C" />
            <SolidColorBrush x:Key="StatusServerErrorBg" Color="#FEE2E2" />
            <SolidColorBrush x:Key="StatusServerErrorFg" Color="#B91C1C" />
            <SolidColorBrush x:Key="StatusConnFailedBg" Color="#E4E4E7" />
            <SolidColorBrush x:Key="StatusConnFailedFg" Color="#52525B" />

            <!-- Legacy aliases -->
            <SolidColorBrush x:Key="PostmanBlueBrush" Color="#2E7CF6" />
            <SolidColorBrush x:Key="PostmanGreenBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="PostmanRedBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="PostmanAmberBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="PostmanPurpleBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="PostmanGrayBrush" Color="#6B7280" />
            <StaticResource x:Key="PostmanTextPrimaryBrush" ResourceKey="TextPrimary" />
            <StaticResource x:Key="PostmanTextSecondaryBrush" ResourceKey="TextSecondary" />
            <StaticResource x:Key="PostmanBorderBrush" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="PostmanPanelBackgroundBrush" ResourceKey="BgHover" />
            <StaticResource x:Key="PostmanSurfaceBackgroundBrush" ResourceKey="BgEditorCanvas" />

            <!-- Fluent TabItem tokens - underline-tab look. -->
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelectedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselectedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelectedPressed" ResourceKey="TextPrimary" />
            <SolidColorBrush x:Key="TabItemHeaderForegroundDisabled" Color="#C0C4CC" />
            <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="PostmanOrangeBrush" />

        </ResourceDictionary>

        <!-- ================================================================ -->
        <!-- DARK THEME VARIANT                                               -->
        <!-- ================================================================ -->
        <ResourceDictionary x:Key="Dark">

            <!-- Sidebar / navigation surfaces -->
            <SolidColorBrush x:Key="BgSidebar" Color="#141416" />
            <SolidColorBrush x:Key="BgHeader" Color="#1E1E22" />
            <SolidColorBrush x:Key="BgHover" Color="#282830" />
            <SolidColorBrush x:Key="BgSelected" Color="#2D323E" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#2B2B32" />
            <SolidColorBrush x:Key="TextPrimary" Color="#ECECEF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#94949E" />

            <SolidColorBrush x:Key="MethodGetBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="MethodPostBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="MethodPutBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="MethodDeleteBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="MethodOtherBrush" Color="#A855F7" />

            <SolidColorBrush x:Key="StatusDirty" Color="#FF9800" />
            <SolidColorBrush x:Key="BadgeAuth" Color="#0284C7" />
            <SolidColorBrush x:Key="BadgeAuthNone" Color="#475569" />

            <!-- Editor / content canvas -->
            <SolidColorBrush x:Key="BgEditorCanvas" Color="#1A1A1D" />
            <SolidColorBrush x:Key="BorderEditor" Color="#2B2B32" />
            <SolidColorBrush x:Key="BtnSendBg" Color="#3B82F6" />
            <SolidColorBrush x:Key="VariableValidBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="VariableUndefinedBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="BgInheritedRow" Color="#1E1E22" />

            <!-- Secondary / detail panel -->
            <SolidColorBrush x:Key="BgResponsePanel" Color="#141416" />
            <SolidColorBrush x:Key="BgResponseHeader" Color="#1E1E22" />
            <SolidColorBrush x:Key="JsonKey" Color="#93C5FD" />
            <SolidColorBrush x:Key="JsonString" Color="#4ADE80" />
            <SolidColorBrush x:Key="JsonNumber" Color="#F6AD55" />
            <SolidColorBrush x:Key="JsonBoolean" Color="#F472B6" />
            <SolidColorBrush x:Key="JsonNull" Color="#A1A1AA" />
            <SolidColorBrush x:Key="SearchHighlight" Color="#F59E0B" />

            <!-- Status badge ranges -->
            <SolidColorBrush x:Key="StatusInfoBg" Color="#1E293B" />
            <SolidColorBrush x:Key="StatusInfoFg" Color="#94A3B8" />
            <SolidColorBrush x:Key="StatusSuccessBg" Color="#14532D" />
            <SolidColorBrush x:Key="StatusSuccessFg" Color="#4ADE80" />
            <SolidColorBrush x:Key="StatusRedirectBg" Color="#1E3A8A" />
            <SolidColorBrush x:Key="StatusRedirectFg" Color="#60A5FA" />
            <SolidColorBrush x:Key="StatusClientErrorBg" Color="#7C2D12" />
            <SolidColorBrush x:Key="StatusClientErrorFg" Color="#FB923C" />
            <SolidColorBrush x:Key="StatusServerErrorBg" Color="#7F1D1D" />
            <SolidColorBrush x:Key="StatusServerErrorFg" Color="#F87171" />
            <SolidColorBrush x:Key="StatusConnFailedBg" Color="#3F3F46" />
            <SolidColorBrush x:Key="StatusConnFailedFg" Color="#A1A1AA" />

            <!-- Legacy aliases -->
            <SolidColorBrush x:Key="PostmanBlueBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="PostmanGreenBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="PostmanRedBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="PostmanAmberBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="PostmanPurpleBrush" Color="#A855F7" />
            <SolidColorBrush x:Key="PostmanGrayBrush" Color="#94949E" />
            <StaticResource x:Key="PostmanTextPrimaryBrush" ResourceKey="TextPrimary" />
            <StaticResource x:Key="PostmanTextSecondaryBrush" ResourceKey="TextSecondary" />
            <StaticResource x:Key="PostmanBorderBrush" ResourceKey="BorderSubtle" />
            <StaticResource x:Key="PostmanPanelBackgroundBrush" ResourceKey="BgHover" />
            <StaticResource x:Key="PostmanSurfaceBackgroundBrush" ResourceKey="BgEditorCanvas" />

            <!-- Fluent TabItem tokens - underline-tab look. -->
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemHeaderBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelectedPointerOver" ResourceKey="TextPrimary" />
            <StaticResource x:Key="TabItemHeaderForegroundUnselectedPressed" ResourceKey="TextSecondary" />
            <StaticResource x:Key="TabItemHeaderForegroundSelectedPressed" ResourceKey="TextPrimary" />
            <SolidColorBrush x:Key="TabItemHeaderForegroundDisabled" Color="#5A5A63" />
            <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="PostmanOrangeBrush" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
