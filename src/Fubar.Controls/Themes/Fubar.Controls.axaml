<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The design-system STYLE include for the Fubar.Controls component library. A host app adds two
         lines to get the full, consistent look-and-feel:

           1. the palette (in Application.Resources, so RequestedThemeVariant switching works):
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Palette.axaml" />
           2. this file (in Application.Styles):
                <StyleInclude Source="avares://Fubar.Controls/Themes/Fubar.Controls.axaml" />

         This pulls in:
           - control themes for every component (Badge, StatusDot, Chip, ValidityIcon, IconButton,
             PillToggle, Divider, Card, SectionHeader, EmptyState, LabeledField, Toolbar, SearchBox);
           - the SeamlessTabControl styles;
           - shared Button class styles (.toolbar-btn/.primary-btn/.secondary-btn/.icon-btn/
             .icon-btn-danger/.TabPill);
           - Chrome-style workspace-tab styles (Border.WorkspaceTab).

         Colours resolve via DynamicResource from Palette.axaml, so everything follows the app's
         Dark/Light theme. -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Badges.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Buttons.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Layout.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/SearchBox.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/KeyValueGrid.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Tabs.axaml" />
                <ResourceInclude Source="avares://Fubar.Controls/Themes/Feedback.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Fubar.Controls/Themes/SeamlessTab.axaml" />
    <StyleInclude Source="avares://Fubar.Controls/Themes/TreeView.axaml" />
    <StyleInclude Source="avares://Fubar.Controls/Themes/ButtonStyles.axaml" />
    <StyleInclude Source="avares://Fubar.Controls/Themes/WorkspaceTabStyles.axaml" />
    <StyleInclude Source="avares://Fubar.Controls/Themes/VariableTooltipStyles.axaml" />
    <StyleInclude Source="avares://Fubar.Controls/Themes/AppStyles.axaml" />

</Styles>
