<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fc="using:Fubar.Controls">

    <!-- fc:TabStrip (a ListBox subclass) drawn as a horizontal Chrome-style tab strip. The tab label is
         the host's ItemTemplate; each container adds an optional close button. Selection uses the
         ListBox :selected pseudo-class; the strip's drag code toggles .tab-dragging (dimmed while picked
         up) and .tab-floating (hidden while floating as the ghost) on the dragged container. Colours are
         palette tokens, matching WorkspaceTabStyles.

         The per-tab (ListBoxItem) look lives in a SEPARATE ControlTheme applied via ItemContainerTheme -
         a ControlTheme may not contain descendant selectors (e.g. "^ ListBoxItem"), so container styling
         cannot be nested inside the TabStrip theme itself. -->

    <!-- Each tab container -->
    <ControlTheme x:Key="FubarTabStripItemTheme" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <!-- x:CompileBindings=False: the tab item type is unknown (app-agnostic strip), so
                 CommandParameter="{Binding}" (the item) and the $parent[ListBox] ancestor bindings
                 resolve by reflection. $parent[ListBox] (built-in) finds the owning TabStrip. -->
            <ControlTemplate x:CompileBindings="False">
                <Border Name="root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8,8,0,0"
                        Padding="12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                        <fc:IconButton Grid.Column="1"
                                       Content="&#x2715;"
                                       FontSize="9"
                                       Padding="4,2"
                                       Margin="4,0,0,0"
                                       IsVisible="{Binding $parent[ListBox].ShowCloseButton}"
                                       Command="{Binding $parent[ListBox].CloseCommand}"
                                       CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}" />
        </Style>

        <!-- Drag state (toggled from TabStrip.cs) -->
        <Style Selector="^.tab-dragging">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="^.tab-floating">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!-- The strip itself -->
    <ControlTheme x:Key="{x:Type fc:TabStrip}" TargetType="fc:TabStrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource FubarTabStripItemTheme}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
        <!-- No ScrollViewer around the items: its ScrollGestureRecognizer treats a horizontal mouse drag
             as a pan and captures the pointer, swallowing the very drag this strip owns (reorder /
             tear-off) - clicks still select, but nothing drags. A title-bar tab row doesn't pan-scroll,
             so the items go straight under a clipping Border; overflow tabs are clipped rather than
             scrolled. PART_DropCaret is an accent insertion marker the drag code positions/shows at the
             drop slot; the .drag-over class (also set from the drag code) outlines the strip a floating
             tab would dock into. -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{DynamicResource PostmanOrangeBrush}"
                        BorderThickness="0"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Panel>
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                        <Border Name="PART_DropCaret"
                                Width="2.5"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                CornerRadius="1.5"
                                Background="{DynamicResource PostmanOrangeBrush}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Highlight the strip a floating tab would drop into (set from the drag code). -->
        <Style Selector="^.drag-over /template/ Border#PART_Root">
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
