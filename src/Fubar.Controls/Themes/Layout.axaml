<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Data.Converters"
                    xmlns:fc="using:Fubar.Controls">

    <!-- Layout/structure primitives: Divider, Card, SectionHeader, EmptyState, LabeledField, Toolbar.
         Card composes Divider; SectionHeader/EmptyState expose action slots that hosts fill with
         IconButton/Button. -->

    <!-- Divider: a 1px rule, horizontal or vertical. -->
    <ControlTheme x:Key="{x:Type fc:Divider}" TargetType="fc:Divider">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Width" Value="1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </ControlTheme>

    <!-- Card: bordered surface with an optional header strip + divider. -->
    <ControlTheme x:Key="{x:Type fc:Card}" TargetType="fc:Card">
        <Setter Property="Background" Value="{DynamicResource BgEditorCanvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderEditor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    IsVisible="{TemplateBinding Header, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Margin="12,10"
                                              FontWeight="SemiBold" />
                            <fc:Divider Margin="0" />
                        </StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- SectionHeader: uppercase-style group title + right-aligned action slot. Defaults to a flat,
         semibold, secondary-colour label; set Background (a banded strip), Foreground and FontWeight to
         get the heavier "group header" treatment (see Fubar API Studio's Left Pane groups). -->
    <ControlTheme x:Key="{x:Type fc:SectionHeader}" TargetType="fc:SectionHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="11"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Action}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Section: a banded group header (Title + Action slot) over its Content - the Left Pane's
         REQUESTS / ENVIRONMENTS / AUTH PROFILES group pattern in one component. Composes SectionHeader
         for the header (with the heavy "group" treatment baked in: BgHeader band, primary text, bold),
         and a ContentPresenter for the body (host supplies the list / tree / empty-state). Draws a bottom
         divider via BorderThickness (default 0,0,0,1); set BorderThickness="0" on the last one in a
         stack. Content sits in a star row so a stretching child (a tree filling the pane) works. -->
    <!-- The clickable header of a collapsible Section.

         Fluent's ToggleButton theme is replaced OUTRIGHT rather than overridden setter by setter,
         which was tried first and does not work: an expanded section's toggle is :checked, Fluent
         paints a checked ToggleButton in the system accent, and its own ControlTheme wins over styles
         nested in ours - so the one section open by default rendered as a solid blue bar across the
         sidebar. A Border plus a ContentPresenter renders only what is asked for. Same reasoning as
         SeamlessTab.axaml replacing Fluent's TabItem template. -->
    <ControlTheme x:Key="SectionToggleTheme" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Band"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- No :checked style at all - folded and unfolded look the same, because the chevron is what
             says which one it is. -->
        <Style Selector="^:pointerover /template/ Border#PART_Band">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type fc:Section}" TargetType="fc:Section">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid RowDefinitions="Auto,*">

                        <!-- The title is a ToggleButton bound straight to IsExpanded rather than a
                             command the host has to supply. A section that ships with a chevron doing
                             nothing is this repository's own recurring failure; there is nothing to
                             forget to wire if the control folds itself. The Action slot stays OUTSIDE
                             it - a "+" nested inside the toggle would collapse the section on its way
                             to adding something. -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <ToggleButton Grid.Column="0"
                                          Theme="{StaticResource SectionToggleTheme}"
                                          IsHitTestVisible="{TemplateBinding IsCollapsible}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{DynamicResource IconChevron}"
                                              Width="10" Height="10"
                                              Classes="section-chevron"
                                              IsVisible="{TemplateBinding IsCollapsible}"
                                              Foreground="{DynamicResource TextSecondary}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Action}"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                        </Grid>

                        <ContentPresenter Grid.Row="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{TemplateBinding IsExpanded}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Rotated rather than swapped for a second geometry, so the two states cannot drift apart. -->
        <Style Selector="^ /template/ PathIcon.section-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="^[IsExpanded=True] /template/ PathIcon.section-chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </ControlTheme>

    <!-- EmptyState: centered icon + title + description + optional action. -->
    <ControlTheme x:Key="{x:Type fc:EmptyState}" TargetType="fc:EmptyState">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="24">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                MaxWidth="360">
                        <TextBlock Text="{TemplateBinding Icon}"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   IsVisible="{TemplateBinding Icon, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Title, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{TemplateBinding Description}"
                                   FontSize="12"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <ContentPresenter Content="{TemplateBinding Action}"
                                          HorizontalAlignment="Center"
                                          Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- LabeledField: caption (Header) + field (Content), stacked or side-by-side. -->
    <ControlTheme x:Key="{x:Type fc:LabeledField}" TargetType="fc:LabeledField">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <ContentPresenter Name="PART_Label"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="12" />
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Orientation=Vertical] /template/ ContentPresenter#PART_Label">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ ContentPresenter#PART_Label">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <!-- SettingRow: header + plain-language description on the left, the control itself on the right.
         The description is a real element rather than a tooltip, so a settings page can be read
         top-to-bottom without hovering anything. -->
    <ControlTheme x:Key="{x:Type fc:SettingRow}" TargetType="fc:SettingRow">
        <!-- A row filters itself out when the settings search does not match it. Here rather than in
             each host's markup: the search term is an inherited attached property, so a window sets it
             once at the top and no row can be forgotten. -->
        <Setter Property="IsVisible" Value="{Binding MatchesFilter, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,7">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          TextElement.Foreground="{DynamicResource TextPrimary}"
                                          TextElement.FontSize="13" />
                        <TextBlock Text="{TemplateBinding Description}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Toolbar: horizontal items strip with consistent spacing. -->
    <ControlTheme x:Key="{x:Type fc:Toolbar}" TargetType="fc:Toolbar">
        <Setter Property="Background" Value="{DynamicResource BgHeader}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- MetricChip: icon + monospace value (latency / size / count readouts). -->
    <ControlTheme x:Key="{x:Type fc:MetricChip}" TargetType="fc:MetricChip">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Icon}"
                               FontSize="{TemplateBinding FontSize}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Icon, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{TemplateBinding Text}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
