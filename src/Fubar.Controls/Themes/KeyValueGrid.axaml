<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Data.Converters"
                    xmlns:fc="using:Fubar.Controls">

    <!-- Dumb editable key/value(/description) grid. Rows are expected to expose Enabled/Key/Value/
         Description members (the default cells two-way bind to them); a host can replace any column's
         cell via KeyCellTemplate/ValueCellTemplate/DescriptionCellTemplate. Add/remove go through the
         AddCommand/RemoveCommand the host supplies. Styling uses palette tokens + the shared
         .secondary-btn / .icon-btn button classes. -->

    <ControlTheme x:Key="{x:Type fc:KeyValueGrid}" TargetType="fc:KeyValueGrid">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>

                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="6,0,6,8">
                        <Grid ColumnDefinitions="28,2*,2*,2*,28">
                            <TextBlock Grid.Column="1" Text="{TemplateBinding KeyHeader}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding ValueHeader}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="{TemplateBinding DescriptionHeader}" IsVisible="{TemplateBinding ShowDescription}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Add -->
                    <Button DockPanel.Dock="Bottom"
                            Classes="secondary-btn"
                            Content="{TemplateBinding AddButtonText}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{TemplateBinding AddCommand}" />

                    <!-- Rows -->
                    <ScrollViewer>
                        <!-- Tag carries the KeyValueGrid itself so the row template can reach the control's
                             cell-templates/commands via a BUILT-IN ancestor (ItemsControl), not $parent[fc:...]
                             which a reflection binding can't resolve at runtime. -->
                        <ItemsControl ItemsSource="{TemplateBinding ItemsSource}"
                                      Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemTemplate>
                                <!-- x:CompileBindings=False: the row type is unknown here (the grid is
                                     app-agnostic), so Key/Value/Enabled/Description resolve by reflection.
                                     Ancestor references go through $parent[ItemsControl].Tag (the grid). -->
                                <DataTemplate x:CompileBindings="False">
                                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="6,6">
                                        <Grid ColumnDefinitions="28,2*,2*,2*,28">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Enabled}"
                                                      IsVisible="{Binding $parent[ItemsControl].Tag.ShowEnabled}"
                                                      VerticalAlignment="Center" />

                                            <!-- Key cell: a KeyCellTemplate when the host supplies one; else an
                                                 autocomplete box when KeySuggestions are provided (header/param
                                                 name hints); else a plain TextBox. The three are mutually
                                                 exclusive - visibility is gated on which of those the host set. -->
                                            <Panel Grid.Column="1" Margin="2,0">
                                                <TextBox Text="{Binding Key}" PlaceholderText="Key" BorderThickness="0" Background="Transparent">
                                                    <TextBox.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="$parent[ItemsControl].Tag.KeyCellTemplate" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                                                            <Binding Path="$parent[ItemsControl].Tag.KeySuggestions" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                                                        </MultiBinding>
                                                    </TextBox.IsVisible>
                                                </TextBox>
                                                <AutoCompleteBox Text="{Binding Key, Mode=TwoWay}"
                                                                 ItemsSource="{Binding $parent[ItemsControl].Tag.KeySuggestions}"
                                                                 PlaceholderText="Key"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 FilterMode="ContainsOrdinal"
                                                                 MinimumPrefixLength="0"
                                                                 MaxDropDownHeight="220">
                                                    <AutoCompleteBox.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="$parent[ItemsControl].Tag.KeyCellTemplate" Converter="{x:Static conv:ObjectConverters.IsNull}" />
                                                            <Binding Path="$parent[ItemsControl].Tag.KeySuggestions" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                                                        </MultiBinding>
                                                    </AutoCompleteBox.IsVisible>
                                                </AutoCompleteBox>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{Binding $parent[ItemsControl].Tag.KeyCellTemplate}"
                                                                IsVisible="{Binding $parent[ItemsControl].Tag.KeyCellTemplate, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                            </Panel>

                                            <!-- Value cell -->
                                            <Panel Grid.Column="2" Margin="2,0">
                                                <TextBox Text="{Binding Value}" PlaceholderText="Value" BorderThickness="0" Background="Transparent"
                                                         IsVisible="{Binding $parent[ItemsControl].Tag.ValueCellTemplate, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{Binding $parent[ItemsControl].Tag.ValueCellTemplate}"
                                                                IsVisible="{Binding $parent[ItemsControl].Tag.ValueCellTemplate, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                            </Panel>

                                            <!-- Description cell -->
                                            <Panel Grid.Column="3" Margin="2,0" IsVisible="{Binding $parent[ItemsControl].Tag.ShowDescription}">
                                                <TextBox Text="{Binding Description}" PlaceholderText="Description" BorderThickness="0" Background="Transparent"
                                                         IsVisible="{Binding $parent[ItemsControl].Tag.DescriptionCellTemplate, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{Binding $parent[ItemsControl].Tag.DescriptionCellTemplate}"
                                                                IsVisible="{Binding $parent[ItemsControl].Tag.DescriptionCellTemplate, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                            </Panel>

                                            <Button Grid.Column="4"
                                                    Classes="icon-btn"
                                                    Content="&#x2715;"
                                                    FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].Tag.RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
