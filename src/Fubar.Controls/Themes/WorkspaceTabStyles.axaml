<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chrome-style workspace tabs for the extended title bar: rounded top corners only, inactive tabs
         recessed into the title bar's background, the active tab's background matching the content area
         below it so it visually "merges" with what's showing - the illusion a browser's active tab
         creates. Apply Classes="WorkspaceTab" (+ Classes.Active) to a Border. Colours are palette
         tokens (Palette.axaml). -->

    <Style Selector="Border.WorkspaceTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style Selector="Border.WorkspaceTab:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <Style Selector="Border.WorkspaceTab.Active">
        <Setter Property="Background" Value="{DynamicResource BgSidebar}" />
    </Style>

    <Style Selector="Border.WorkspaceTab.Active:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgSidebar}" />
    </Style>

</Styles>
