<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="using:Fubar.Controls">

    <!-- Shared app-shell styles so every app on Fubar.Controls looks identical without defining any
         styles of its own: the window font, the request-tree row look, and the flat list-row look
         (environments / auth profiles). All colours are palette tokens. -->

    <!-- Typography: Inter everywhere (the design system owns the font). -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>

    <!-- Explorer-tree row styling moved to Themes/TreeView.axaml, scoped to the fc:TreeView component. -->

    <!-- Row action buttons (rename/delete). The icon is a cross-platform vector PathIcon (see
         Icons.axaml) set as the button's content, so no platform-specific icon font is needed - this
         class now only carries the hover-reveal behaviour below (Border.ListRow rules). -->
    <Style Selector="Button.RowActionGlyph">
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Flat list rows (environments / auth profiles) matching the request tree: full-row click target
         with the same hover/selected backgrounds and row height. The rename/delete glyphs stay hidden
         until the row is hovered. -->
    <Style Selector="Border.ListRow">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.ListRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="Border.ListRow Button.RowActionGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.ListRow:pointerover Button.RowActionGlyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The switch in a SettingRow. Fluent writes "On"/"Off" beside the knob by default, which in a
         column of rows is the same word repeated fifteen times to say what the knob already shows.
         Scoped to SettingRow (a descendant selector, so it cannot live in the ControlTheme) rather
         than styling every ToggleSwitch an app might have. -->
    <Style Selector="fc|SettingRow ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

</Styles>
