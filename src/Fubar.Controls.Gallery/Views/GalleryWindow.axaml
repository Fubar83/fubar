<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="using:Fubar.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Fubar.Controls.Gallery.Views.GalleryWindow"
        Title="Fubar.Controls Gallery"
        Width="1000" Height="700"
        Background="{DynamicResource BgSidebar}">

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar: title + Dark/Light toggle -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgHeader}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Fubar.Controls Gallery"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" />
                <fc:PillToggle Grid.Column="1"
                               x:Name="ThemeToggle"
                               Content="Dark"
                               IsChecked="True"
                               IsCheckedChanged="ThemeToggle_OnIsCheckedChanged" />
            </Grid>
        </Border>

        <!-- Nav + content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <ListBox Grid.Column="0"
                     x:Name="Nav"
                     Background="{DynamicResource BgSidebar}"
                     BorderBrush="{DynamicResource BorderSubtle}"
                     BorderThickness="0,0,1,0"
                     SelectionChanged="Nav_OnSelectionChanged">
                <ListBoxItem Content="Primitives" />
                <ListBoxItem Content="Feedback" />
                <ListBoxItem Content="Key Value Grid" />
                <ListBoxItem Content="Tab Strip" />
                <ListBoxItem Content="Tree &amp; Sections" />
                <ListBoxItem Content="JSON Editor" />
            </ListBox>

            <ScrollViewer Grid.Column="1">
                <ContentControl x:Name="PageHost" Margin="20" />
            </ScrollViewer>
        </Grid>

    </Grid>

</Window>
